---
interface Props {
  stacked?: boolean;
}
const { stacked = false } = Astro.props;
const messengers = [
  {
    name: "Telegram",
    href: "https://telegram.me/lenremont_bot",
    qr: "/assets/social/lr-qr-tg.webp",
  },
  {
    name: "MAX",
    href: "https://max.ru/id471902475874_3_bot",
    qr: "/assets/social/lr-qr-max.webp",
  },
  {
    name: "VK",
    href: "https://vk.ru/lenremont",
    qr: "/assets/social/lr-qr-vk.webp",
  },
];
---

<div class:list={["messenger-cards", { "messenger-cards--stacked": stacked }]}>
  {
    messengers.map(({ name, href, qr }) => (
      <a
        class:list={["hero-messenger", `hero-messenger--${name.toLowerCase()}`]}
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Открыть ${name}`}
      >
        {name === "Telegram" && (
          <svg class="hero-messenger__icon hero-messenger__icon--telegram" width="30" height="24" viewBox="0 0 24 20" fill="currentColor" aria-hidden="true"><path d="M21.9539 0.176566C21.9539 0.176566 24.1741 -0.689148 23.989 1.4133C23.9274 2.27903 23.3724 5.30902 22.9406 8.58639L21.4605 18.2948C21.4605 18.2948 21.3374 19.717 20.2271 19.9644C19.117 20.2117 17.4519 19.0987 17.1435 18.8513C16.8968 18.6658 12.5182 15.8831 10.9763 14.5227C10.5446 14.1517 10.0513 13.4096 11.038 12.5439L17.5136 6.36028C18.2536 5.61823 18.9937 3.8868 15.9101 5.98925L7.27606 11.8638C7.27606 11.8638 6.28932 12.4821 4.4392 11.9256L0.430526 10.6888C0.430526 10.6888 -1.04959 9.76131 1.47894 8.83371C7.64612 5.92737 15.2317 2.9592 21.9539 0.176566Z" /></svg>
        )}
        {name === "MAX" && (
          <svg class="hero-messenger__icon hero-messenger__icon--max" width="30" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.2589 23.9315C9.90029 23.9315 8.80729 23.5862 6.90892 22.2049C5.70086 23.7588 1.89262 24.9733 1.73154 22.8955C1.73154 21.3358 1.38063 20.0177 0.995206 18.5789C0.52349 16.8062 0 14.832 0 11.9715C0 5.13969 5.58006 0 12.1956 0C18.8111 0 24 5.39869 24 12.0406C24 18.6825 18.65 23.9373 12.2589 23.9373M12.3567 5.91093C9.13519 5.74402 6.62129 7.98293 6.06903 11.4938C5.60882 14.4003 6.4257 17.94 7.12177 18.1242C7.44967 18.2048 8.28955 17.5256 8.80729 17.0019C9.65868 17.5601 10.6366 17.986 11.7239 18.0436C15.0259 18.2163 17.954 15.6263 18.1323 12.3053C18.1955 10.6964 17.6263 9.12671 16.5467 7.93255C15.4671 6.7384 13.963 6.01477 12.3567 5.91669" /></svg>
        )}
        {name === "VK" && (
          <svg class="hero-messenger__icon hero-messenger__icon--vk" width="34" height="22" viewBox="0 0 67 42" fill="currentColor" aria-hidden="true"><path d="M35.9736 41.625C13.4075 41.625 0.536337 26 0 0H11.3037C11.675 19.0833 20.0081 27.1666 26.6087 28.8333V0H37.2527V16.4582C43.7708 15.7499 50.6181 8.25 52.9284 0H63.5723C61.7983 10.1667 54.3726 17.6666 49.0921 20.7499C54.3726 23.2499 62.8301 29.7916 66.0479 41.625H54.3314C51.8149 33.7083 45.5448 27.5833 37.2527 26.7499V41.625H35.9736Z" /></svg>
        )}
        <strong>{name}</strong>
        <span class="hero-messenger__action">
          Отправить фото <span aria-hidden="true">↗</span>
        </span>
        <img
          src={qr}
          alt={`QR-код ${name} Ленремонт`}
          width="140"
          height="140"
          loading="lazy"
        />
      </a>
    ))
  }
</div>

<style>
  .messenger-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .hero-messenger {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 140px;
    grid-template-rows: 1fr 1fr;
    gap: 12px 16px;
    min-width: 0;
    padding: 20px;
    border: 1px solid #ffffff40;
    border-radius: 12px;
    color: white;
    background: linear-gradient(#ffffff0d, #ffffff0d), var(--night);
    transition:
      filter 0.2s,
      border-color 0.2s;
  }
  .hero-messenger--telegram {
    --messenger-background: linear-gradient(105deg, #51beec, #38a4d5);
  }
  .hero-messenger--vk {
    --messenger-background: linear-gradient(105deg, #3196fa, #0069df);
  }
  .hero-messenger--max {
    --messenger-background: linear-gradient(105deg, #b650ff, #9029e8);
  }
  .hero-messenger:hover {
    filter: brightness(1.08);
    border-color: #ffffff80;
  }
  .hero-messenger strong {
    grid-column: 1;
    grid-row: 1;
    align-self: center;
    font-size: 24px;
    line-height: 1.2;
  }
  .hero-messenger__action {
    grid-column: 1;
    grid-row: 2;
    align-self: end;
    color: white;
    font-size: 15px;
    font-weight: 650;
  }
  .hero-messenger__icon {
    display: none;
    flex: 0 0 auto;
    width: 30px;
    height: 24px;
    fill: currentColor;
    stroke: none;
  }
  .hero-messenger__icon--vk {
    width: 34px;
    height: 22px;
  }
  .hero-messenger img {
    grid-column: 2 / 3;
    grid-row: 1 / 3;
    width: 140px;
    height: 140px;
    padding: 6px;
    border-radius: 8px;
    background: white;
    object-fit: contain;
  }
  .messenger-cards--stacked {
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (max-width: 1050px) {
    .messenger-cards {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .hero-messenger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      min-height: 56px;
      padding: 15px 20px;
      background: var(--messenger-background);
    }
    .hero-messenger strong {
      order: 1;
      font-size: 19px;
    }
    .hero-messenger__icon {
      order: 2;
      display: block;
      margin-left: auto;
    }
    .hero-messenger img,
    .hero-messenger__action {
      display: none;
    }
  }
</style>
