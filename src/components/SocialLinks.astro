---
interface Props {
  isCompact?: boolean;
}

const { isCompact = false } = Astro.props;
const socialLinks = [
  {
    name: "Telegram",
    handle: "@lenremont_bot",
    href: "https://telegram.me/lenremont_bot",
    qr: "/assets/social/lr-qr-tg.webp",
    modifier: "telegram",
  },
  {
    name: "ВКонтакте",
    handle: "vk.ru/lenremont",
    href: "https://vk.ru/lenremont",
    qr: "/assets/social/lr-qr-vk.webp",
    modifier: "vk",
  },
  {
    name: "MAX",
    handle: "max.ru",
    href: "https://max.ru/id471902475874_3_bot",
    qr: "/assets/social/lr-qr-max.webp",
    modifier: "max",
  },
];
---

{
  isCompact ? (
    <div
      class="social-links social-links--compact"
      aria-label="Написать в мессенджере"
    >
      {socialLinks.map((social) => (
        <a
          class:list={[
            "social-links__link",
            `social-links__link--${social.modifier}`,
          ]}
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>{social.name}</span>
          <img
            class="social-links__qr"
            src={social.qr}
            alt={`QR-код ${social.name}`}
            width="196"
            height="196"
          />
        </a>
      ))}
    </div>
  ) : (
    <div class="social-links social-links--cards">
      {socialLinks.map((social) => (
        <a
          class:list={[
            "social-links__card",
            `social-links__card--${social.modifier}`,
          ]}
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>{social.name}</span>
          <img
            src={social.qr}
            alt={`QR-код ${social.name} Ленремонт`}
            loading="lazy"
            width="196"
            height="196"
          />
        </a>
      ))}
    </div>
  )
}

<style>
  .social-links--compact {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 11px;
  }

  .social-links--cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .social-links__link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: 7px;
    color: var(--white);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    transition:
      filter 0.16s ease,
      transform 0.16s ease;
    position: relative;
  }

  .social-links__link:hover {
    color: var(--white);
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .social-links__link--telegram,
  .social-links__card--telegram > span {
    background: #42ace4;
  }

  .social-links__link--vk,
  .social-links__card--vk > span {
    background: #1779e5;
  }

  .social-links__link--max,
  .social-links__card--max > span {
    background: linear-gradient(105deg, #7e3bdf, #c23df1);
  }

  .social-links__qr {
    position: absolute;
    z-index: 5;
    bottom: calc(100% + 12px);
    left: 50%;
    width: 100%;
    aspect-ratio: 1;
    padding: 7px;
    border-radius: 10px;
    background: var(--white);
    box-shadow: 0 14px 30px rgb(0 0 0 / 32%);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(8px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s ease;
    visibility: hidden;
  }

  .social-links__link:hover .social-links__qr,
  .social-links__link:focus-visible .social-links__qr {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    visibility: visible;
  }

  .social-links__card {
    display: grid;
    gap: 11px;
    color: var(--white);
    text-align: center;
    text-decoration: none;
  }

  .social-links__card > span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    gap: 10px;
    padding: 11px 9px;
    border-radius: 9px;
    color: var(--white);
    font-size: 15px;
    font-weight: 800;
    transition:
      filter 0.18s ease,
      transform 0.18s ease;
  }

  .social-links__card > img {
    width: 100%;
    aspect-ratio: 1;
    padding: 8px;
    border-radius: 8px;
    background: var(--white);
    object-fit: contain;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .social-links__card small {
    overflow-wrap: anywhere;
    color: #aaa9a7;
    font-size: 11px;
    text-align: center;
  }

  .social-links__card:hover > span {
    filter: brightness(1.08);
    transform: translateY(-2px);
  }

  .social-links__card:hover > img {
    box-shadow: 0 12px 28px rgb(0 0 0 / 28%);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .social-links__qr {
      display: none !important;
    }
  }

  @media (max-width: 640px) {
    .social-links--compact,
    .social-links--cards {
      grid-template-columns: 1fr;
      gap: 10px;
      width: 100%;
    }

    .social-links__link {
      width: 100%;
      min-height: 48px;
      font-size: 14px;
      border-radius: 8px;
    }

    .social-links__card {
      width: 100%;
    }

    .social-links__card > span {
      width: 100%;
      min-height: 48px;
      font-size: 14px;
      border-radius: 8px;
    }

    .social-links__card > img,
    .social-links__qr {
      display: none !important;
    }
  }
</style>
