---
interface Props {
  href: string;
  variant?: "primary" | "ghost" | "outline";
  dataCta?: string;
  className?: string;
}

const { href, variant = "primary", dataCta, className } = Astro.props;
const classes = ["button", `button--${variant}`, className].filter(Boolean).join(" ");
---

<a class={classes} href={href} data-cta={dataCta}><slot /></a>
