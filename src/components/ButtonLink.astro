---
interface Props {
  href: string;
  variant?: "primary" | "ghost" | "outline";
  dataCta?: string;
  className?: string;
}

const { href, variant = "primary", dataCta, className } = Astro.props;
const classes = ["button", `button--${variant}`, className].filter(Boolean).join(" ");
---

<a class={classes} href={href} data-cta={dataCta}><slot /></a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 54px;
    padding: 13px 22px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-weight: 750;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.18s, border-color 0.18s, transform 0.12s;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button:active {
    transform: translateY(1px);
  }

  .button--primary {
    color: var(--white);
    background: var(--blue);
  }

  .button--primary:hover {
    background: var(--blue-deep);
  }

  .button--ghost,
  .button--outline {
    color: inherit;
    border-color: currentColor;
  }

  .button--ghost:hover,
  .button--outline:hover {
    background: rgb(255 255 255 / 11%);
  }

  .button :global(svg) {
    width: 23px;
    height: 23px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }
</style>
