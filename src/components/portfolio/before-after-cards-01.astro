---
interface BeforeAfterItem {
  beforeSrc?: string;
  afterSrc?: string;
  beforeAlt?: string;
  afterAlt?: string;
  title: string;
  text?: string;
  meta?: string;
}

interface Props {
  eyebrow?: string;
  headline: string;
  subline?: string;
  items: BeforeAfterItem[];
}

const { eyebrow, headline, subline, items } = Astro.props;
---

<section class="before-after-cards">
  <div class="before-after-cards__inner">
    <header class="before-after-cards__header">
      {eyebrow && <p>{eyebrow}</p>}
      <h2>{headline}</h2>
      {subline && <span>{subline}</span>}
    </header>
    <div
      class="before-after-cards__slider swiper"
      data-swiper-options='{"slidesPerView":1,"spaceBetween":22,"breakpoints":{"760":{"slidesPerView":2},"1080":{"slidesPerView":3}}}'
    >
      <div class="before-after-cards__grid swiper-wrapper">
      {items.map((item, index) => (
        <article class="before-after-cards__card swiper-slide">
          <div class="before-after-cards__media">
            {item.beforeSrc ? (
              <a class="before-after-cards__image-link before-after-cards__before glightbox" href={item.beforeSrc} data-gallery={`before-after-${index}`} data-title={`${item.title} before`}>
                <img src={item.beforeSrc} alt={item.beforeAlt ?? ""} loading="lazy" />
              </a>
            ) : (
              <div class="before-after-cards__before before-after-cards__image-placeholder"></div>
            )}
            {item.afterSrc ? (
              <a class="before-after-cards__image-link before-after-cards__after glightbox" href={item.afterSrc} data-gallery={`before-after-${index}`} data-title={`${item.title} after`}>
                <img src={item.afterSrc} alt={item.afterAlt ?? ""} loading="lazy" />
              </a>
            ) : (
              <div class="before-after-cards__after before-after-cards__image-placeholder before-after-cards__image-placeholder--after"></div>
            )}
            <div class="before-after-cards__labels" aria-hidden="true">
              <span>До</span>
              <span>После</span>
            </div>
          </div>
          <div class="before-after-cards__body">
            {item.meta && <p class="before-after-cards__meta">{item.meta}</p>}
            <h3>{item.title}</h3>
            {item.text && <p class="before-after-cards__text">{item.text}</p>}
          </div>
        </article>
      ))}
      </div>
      <div class="before-after-cards__nav" aria-label="Управление слайдером до и после">
        <button class="swiper-button-prev" type="button" aria-label="Предыдущая карточка до и после">Назад</button>
        <button class="swiper-button-next" type="button" aria-label="Следующая карточка до и после">Вперед</button>
      </div>
      <div class="swiper-pagination"></div>
    </div>
  </div>
</section>

<style>
  .before-after-cards {
    padding: var(--spacing-section, 96px) var(--space-4, 16px);
    background: var(--color-background, #ffffff);
    color: var(--color-text, #000000);
  }

  .before-after-cards__inner {
    width: min(100%, var(--container-width, 1180px));
    margin: 0 auto;
  }

  .before-after-cards__header {
    max-width: 780px;
    margin: 0 auto var(--space-10, 40px);
    text-align: center;
  }

  .before-after-cards__header > p {
    margin: 0 0 12px;
    color: var(--color-primary, #000000);
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-xs, 12px);
    font-weight: var(--font-bold, 700);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .before-after-cards h2 {
    margin: 0;
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(30px, 4vw, 52px);
    line-height: var(--leading-tight, 1.12);
    letter-spacing: 0;
  }

  .before-after-cards__header > span {
    display: block;
    margin-top: 18px;
    color: var(--color-text-muted, #000000);
    font-family: var(--font-body, sans-serif);
    line-height: var(--leading-relaxed, 1.65);
  }

  .before-after-cards__slider {
    position: relative;
    overflow: hidden;
    padding: 8px 2px 58px;
  }

  .before-after-cards__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .before-after-cards__slider.swiper-initialized .before-after-cards__grid {
    display: flex;
    gap: 0;
  }

  .before-after-cards__card {
    height: auto;
    overflow: hidden;
    border: 1px solid var(--color-border, #000000);
    border-radius: var(--radius-card, 8px);
    background: var(--color-surface, #ffffff);
    box-shadow: var(--shadow-hard, 6px 6px 0 #000000);
  }

  .before-after-cards__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #e5e5e5;
  }

  .before-after-cards__image-link,
  .before-after-cards__image-link img,
  .before-after-cards__image-placeholder {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.28s ease, transform 0.28s ease;
  }

  .before-after-cards__image-link {
    color: inherit;
    text-decoration: none;
  }

  .before-after-cards__image-link img {
    position: static;
  }

  .before-after-cards__image-placeholder {
    background: #e5e5e5;
  }

  .before-after-cards__image-placeholder--after {
    background: #cfcfcf;
  }

  .before-after-cards__image-placeholder::before {
    position: absolute;
    inset: 28%;
    border: 2px solid #000000;
    content: "";
  }

  .before-after-cards__image-placeholder::after {
    position: absolute;
    top: 34%;
    left: 34%;
    width: 32px;
    height: 32px;
    border: 2px solid #000000;
    border-radius: 50%;
    background: #ffffff;
    content: "";
  }

  .before-after-cards__after {
    opacity: 0;
    transform: scale(1.02);
  }

  .before-after-cards__card:hover .before-after-cards__after,
  .before-after-cards__card:focus-within .before-after-cards__after {
    opacity: 1;
    transform: scale(1);
  }

  .before-after-cards__labels {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .before-after-cards__labels span {
    padding: 6px 10px;
    border-radius: var(--radius-full, 999px);
    background: #000000;
    color: #ffffff;
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-xs, 12px);
    font-weight: var(--font-bold, 700);
  }

  .before-after-cards__body {
    padding: 22px;
  }

  .before-after-cards__meta {
    margin: 0 0 8px;
    color: var(--color-primary, #000000);
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-xs, 12px);
    font-weight: var(--font-bold, 700);
    text-transform: uppercase;
  }

  .before-after-cards h3 {
    margin: 0;
    font-family: var(--font-heading, sans-serif);
    font-size: var(--text-xl, 20px);
    line-height: var(--leading-snug, 1.25);
  }

  .before-after-cards__text {
    margin: 10px 0 0;
    color: var(--color-text-muted, #000000);
    font-family: var(--font-body, sans-serif);
    line-height: var(--leading-relaxed, 1.6);
  }

  .before-after-cards__nav {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    gap: 8px;
    z-index: 3;
  }

  .before-after-cards__nav .swiper-button-prev,
  .before-after-cards__nav .swiper-button-next {
    position: static;
    width: auto;
    height: 42px;
    margin: 0;
    padding: 0 14px;
    border: 1px solid #000000;
    background: #ffffff;
    color: #000000;
    font: inherit;
    font-size: var(--text-xs, 12px);
    font-weight: var(--font-bold, 700);
    text-transform: uppercase;
  }

  .before-after-cards__slider:not(.swiper-initialized) .before-after-cards__nav,
  .before-after-cards__slider:not(.swiper-initialized) .swiper-pagination {
    display: none;
  }

  @media (max-width: 960px) {
    .before-after-cards__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .before-after-cards__grid {
      grid-template-columns: 1fr;
    }

    .before-after-cards__after {
      opacity: 1;
      clip-path: inset(0 0 0 50%);
    }
  }
</style>
