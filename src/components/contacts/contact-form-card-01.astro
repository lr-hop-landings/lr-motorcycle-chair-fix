---
interface Field {
  name: string;
  type?: string;
  placeholder: string;
  required?: boolean;
}

interface Props {
  headline: string;
  subline?: string;
  cta: string;
  action?: string;
  fields?: Field[];
}

const {
  headline,
  subline,
  cta,
  action = "#",
  fields = [
    { name: "name", type: "text", placeholder: "Имя", required: true },
    { name: "phone", type: "tel", placeholder: "Телефон", required: true },
  ],
} = Astro.props;
---

<section class="contact-card" id="contacts">
  <div class="contact-card__inner">
    <div class="contact-card__panel">
      <h2>{headline}</h2>
      {subline && <p>{subline}</p>}
      <form class="contact-card__form" action={action} method="POST">
        {fields.map((field) => (
          <input
            name={field.name}
            type={field.type || "text"}
            placeholder={field.placeholder}
            required={field.required}
          />
        ))}
        <button type="submit">{cta}</button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-card {
    padding: var(--spacing-section, 96px) var(--space-4, 16px);
    background: var(--color-background, #ffffff);
  }

  .contact-card__inner {
    width: min(100%, var(--container-width, 1180px));
    margin: 0 auto;
  }

  .contact-card__panel {
    padding: var(--space-12, 48px);
    border-radius: var(--radius-card, 22px);
    background: #000000;
    color: var(--color-white, #ffffff);
    box-shadow: var(--shadow-hard, 6px 6px 0 #000000);
    text-align: center;
  }

  .contact-card h2 {
    margin: 0;
    font-family: var(--font-heading, sans-serif);
    font-size: var(--text-3xl, 44px);
    line-height: var(--leading-tight, 1.12);
  }

  .contact-card p {
    max-width: 720px;
    margin: var(--space-4, 16px) auto 0;
    color: #ffffff;
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-base, 16px);
    line-height: var(--leading-relaxed, 1.6);
  }

  .contact-card__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)) auto;
    gap: var(--space-4, 16px);
    margin-top: var(--space-8, 32px);
  }

  .contact-card input,
  .contact-card button {
    min-height: 56px;
    border: 0;
    border-radius: var(--radius-button, 14px);
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-base, 16px);
  }

  .contact-card input {
    padding: 0 var(--space-5, 20px);
    background: var(--color-background, #ffffff);
    color: var(--color-text, #000000);
  }

  .contact-card button {
    padding: 0 var(--space-8, 32px);
    background: var(--color-accent, #000000);
    color: var(--color-white, #ffffff);
    font-weight: var(--font-bold, 700);
    cursor: pointer;
  }

  @media (max-width: 820px) {
    .contact-card__panel {
      padding: var(--space-8, 32px) var(--space-5, 20px);
    }

    .contact-card__form {
      grid-template-columns: 1fr;
    }
  }
</style>
