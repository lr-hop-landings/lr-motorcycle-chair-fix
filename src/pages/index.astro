---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Перетяжка сидений мотоциклов и квадроциклов в СПб | Ленремонт";
const description = "Перетяжка и ремонт сидений мотоциклов, квадроциклов и другой мототехники в Санкт-Петербурге. Подбор материала и предварительный расчет по фото.";
const phone = "+7 (812) 344-44-44";
const proof = [
  ["01", "Предварительная оценка по фото", "Пришлите несколько ракурсов — уточним задачу и порядок стоимости."],
  ["02", "Материал и дизайн согласуем заранее", "Обсуждаем применимые образцы, сочетания, строчку и детали до раскроя."],
  ["03", "Договор и согласованная стоимость", "После осмотра согласуем окончательную цену и оформляем договор оказания услуг."],
  ["04", "Гарантия 1 год", "Гарантийный срок заявлен на официальной странице; условия фиксируются в документах на заказ."]
];
const vehicles = [
  ["Мотоциклы и скутеры", "Восстановление обивки, обновление внешнего вида и подбор фактуры с учетом посадки."],
  ["Квадроциклы и багги", "Работаем с сиденьями сложной формы и подбираем вариант под условия эксплуатации."],
  ["Другая мототехника", "Пришлите фото — проверим возможность работы именно с вашим сиденьем."]
];
const process = ["Присылаете фото и описываете задачу.", "Получаете предварительную оценку и возможные варианты.", "Согласовываем передачу сиденья или техники.", "После осмотра выбираем материал, дизайн и окончательную стоимость.", "Проверяем посадку чехла и выдаем заказ."];
const faqs = [
  ["Какие фотографии нужны для расчета?", "Нужны 2–4 кадра: общий вид сиденья, повреждение крупно и, если сиденье снято, нижняя сторона с креплениями. Можно приложить пример желаемого результата."],
  ["Можно ли назвать цену только по фотографии?", "По фото можно сориентировать по возможному решению и порядку стоимости. Окончательная цена зависит от состояния основания и наполнителя, формы, материала и сложности пошива; ее согласуют после осмотра."],
  ["Какие материалы можно выбрать?", "Конкретный материал рекомендуют после осмотра и уточнения условий эксплуатации. Перед началом работ согласуют фактуру, цвет и детали дизайна."],
  ["Есть ли гарантия?", "На официальной странице для перетяжки заявлена гарантия 1 год. Перед началом работ уточните, что входит в гарантию, исключения и документ, который ее подтверждает."],
  ["Как передать сиденье?", "Сценарий передачи согласуют после предварительной оценки. Доступность и стоимость доставки зависят от адреса и габаритов; подтвердим их до оформления."]
];
const caseStudies = [
  { number: "01", before: "/assets/moto-seat/workshop-staging.png", after: "/assets/moto-seat/finished-seat-staging.png", title: "Контрастная строчка и двухфактурная обивка", text: "Сценарий обновления посадочной зоны с акцентом на материал и линию шва.", tags: "ВИЗУАЛ КОНЦЕПЦИИ · МОТОСИДЕНЬЕ" },
  { number: "02", before: "/assets/moto-seat/materials-staging.png", after: "/assets/moto-seat/finished-seat-staging.png", title: "Фактура, цвет и посадка в одном решении", text: "Концепт, в котором выбор покрытия и форма сиденья рассматриваются вместе.", tags: "ВИЗУАЛ КОНЦЕПЦИИ · ПОДБОР МАТЕРИАЛА" },
  { number: "03", before: "/assets/moto-seat/workshop-staging.png", after: "/assets/moto-seat/materials-staging.png", title: "Детали, которые меняют впечатление", text: "Вариант сочетания материалов для обсуждения до начала пошива.", tags: "ВИЗУАЛ КОНЦЕПЦИИ · ДИЗАЙН" }
];
const serviceSchema = { "@context": "https://schema.org", "@type": "Service", name: "Перетяжка сидений мототехники", provider: { "@type": "Organization", name: "Ленремонт", telephone: "+78123444444" }, areaServed: { "@type": "City", name: "Санкт-Петербург" }, description };
---
<BaseLayout title={title} description={description}>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy container">
        <p class="eyebrow">МАСТЕРСКАЯ · САНКТ-ПЕТЕРБУРГ И ЛО</p>
        <h1 id="hero-title"><span>Перетяжка сидений</span><span>мотоциклов, квадроциклов</span><span>и другой мототехники</span></h1>
        <p class="hero__lead">Восстановим поврежденную обивку или изменим внешний вид сиденья. Подберем материал под вашу технику и предварительно рассчитаем работу по фотографиям.</p>
        <ul class="hero__benefits" aria-label="Преимущества мастерской">
          <li>Итоговую стоимость согласуем до начала работы</li>
          <li>Гарантия на перетяжку — 1 год</li>
          <li>Доставка техники в мастерскую и обратно</li>
        </ul>
        <div class="hero__actions">
          <a class="button button--primary" href="#estimate" data-cta="hero"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7.5h3l1.35-2h7.3l1.35 2h3a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2Z"/><circle cx="12" cy="13.5" r="3.25"/></svg>Рассчитать перетяжку по фото</a>
          <a class="button button--ghost" href="#portfolio">Посмотреть работы</a>
        </div>
      </div>
      <div class="hero__drawing" aria-hidden="true"><svg class="hero__measure" viewBox="0 0 580 205"><path class="hero__seat-outline" d="M95 109c16-32 48-47 82-49 39-3 70 11 102 16 46 8 79 4 126 21 29 10 57 31 87 56l-59 7c-32-24-63-35-99-39-47-5-87 2-132 1-43-1-79-6-107-13Z"/><path class="hero__seat-dots" d="M111 106c24-25 49-33 77-35 34-2 61 10 96 16 46 8 81 6 116 20"/><path class="hero__dimension" d="M60 160h421M60 139v42M481 139v42M77 160h387M77 155l-11 5 11 5M464 155l11 5-11 5M61 55v82M82 55H40M82 137H40M61 72v48M56 72l5-11 5 11M56 120l5 11 5-11"/><text x="241" y="184">680</text><text x="14" y="103">320</text></svg></div>
      <div class="hero__visual" aria-label="Staging-визуал процесса перетяжки">
        <img src="/assets/moto-seat/workshop-staging.png" alt="Staging-визуал: мастер прошивает обивку мотоциклетного сиденья на промышленной машине" width="1536" height="1024" fetchpriority="high" />
        <span class="hero__stamp">ВИЗУАЛ КОНЦЕПЦИИ · ЗАМЕНИТЬ НА ФОТО МАСТЕРСКОЙ</span>
      </div>
    </section>

    <section class="proof section" aria-labelledby="proof-title">
      <div class="container"><p class="eyebrow">СНАЧАЛА СОГЛАСОВАНИЕ — ЗАТЕМ РАБОТА</p><h2 id="proof-title">Понятно, что меняем, каким материалом и за какую сумму</h2><div class="accent-line"></div>
        <div class="proof__grid">{proof.map(([number, heading, text]) => <article class="proof__item"><span>{number}</span><h3>{heading}</h3><p>{text}</p></article>)}</div>
      </div>
    </section>

    <section class="estimate section" id="estimate" aria-labelledby="estimate-title">
      <div class="container estimate__grid">
        <div class="estimate__form-wrap"><p class="eyebrow">НЕ НУЖНО ОПИСЫВАТЬ ПОВРЕЖДЕНИЕ СЛОВАМИ</p><h2 id="estimate-title" tabindex="-1">Покажите сиденье — подскажем возможный вариант и порядок стоимости</h2><p class="section-lead">Сфотографируйте сиденье целиком, повреждение крупно и нижнюю сторону, если сиденье уже снято.</p>
          <form class="lead-quiz" data-lead-root data-hop-lead-form novalidate>
            <input type="hidden" name="cta_source" value="direct" />
            <div class="lead-quiz__progress" aria-live="polite"><div class="lead-quiz__progress-meta"><span>ПРЕДВАРИТЕЛЬНЫЙ РАСЧЁТ</span><strong data-quiz-counter>ВЫ ПРОШЛИ 1 ИЗ 4 ШАГОВ</strong></div><div class="lead-quiz__progress-track" aria-hidden="true"><span data-quiz-progress></span></div></div>

            <fieldset class="lead-quiz__step is-active" data-quiz-step="1">
              <legend>На какой технике нужно перетянуть сиденье?</legend>
              <p>Это поможет сразу передать заявку подходящему специалисту.</p>
              <div class="quiz-choice-grid">
                <label class="quiz-choice"><input type="radio" name="vehicle" value="Мотоцикл или скутер" required /><span><b>01</b>Мотоцикл или скутер</span></label>
                <label class="quiz-choice"><input type="radio" name="vehicle" value="Квадроцикл или багги" required /><span><b>02</b>Квадроцикл или багги</span></label>
                <label class="quiz-choice"><input type="radio" name="vehicle" value="Другая мототехника" required /><span><b>03</b>Другая мототехника</span></label>
              </div>
            </fieldset>

            <fieldset class="lead-quiz__step" data-quiz-step="2" hidden>
              <legend>Что вы хотите изменить?</legend>
              <p>Можно выбрать главный сценарий — детали обсудим по фотографиям.</p>
              <div class="quiz-choice-grid">
                <label class="quiz-choice"><input type="radio" name="task" value="Восстановить обивку" required /><span><b>01</b>Восстановить обивку</span></label>
                <label class="quiz-choice"><input type="radio" name="task" value="Обновить дизайн" required /><span><b>02</b>Обновить дизайн</span></label>
                <label class="quiz-choice"><input type="radio" name="task" value="Нужна консультация" required /><span><b>03</b>Нужна консультация</span></label>
              </div>
              <label class="quiz-field" for="model">Модель техники <em>необязательно</em><input id="model" name="model" type="text" autocomplete="off" placeholder="Например, Honda CB 400" /></label>
            </fieldset>

            <fieldset class="lead-quiz__step" data-quiz-step="3" hidden>
              <legend>Добавьте 2–4 фотографии сиденья</legend>
              <p>Нужны общий вид, повреждение крупно и крепления. Это можно сделать прямо с телефона.</p>
              <label class="upload" for="photos"><span class="upload__mark">+</span><span><strong>Выберите фотографии</strong><small>Общий вид, повреждение и крепления</small></span><output id="file-output">Файлы не выбраны</output></label>
              <input id="photos" name="photos[]" type="file" accept="image/*" capture="environment" multiple required />
            </fieldset>

            <fieldset class="lead-quiz__step" data-quiz-step="4" hidden>
              <legend>Куда отправить предварительный расчёт?</legend>
              <p>Оставьте контакт — мастер ответит по вашему сиденью.</p>
              <div class="lead-quiz__contact-grid">
                <label class="quiz-field" for="phone">Телефон для ответа<input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" required /></label>
                <label class="quiz-field" for="contact">Как удобнее ответить<select id="contact" name="contact_method" required><option value="">Выберите способ</option><option>Звонок</option><option>WhatsApp</option><option>Telegram</option></select></label>
              </div>
              <label class="quiz-field" for="comment">Комментарий <em>необязательно</em><textarea id="comment" name="comment" rows="3" placeholder="Например, хочется изменить цвет или фактуру"></textarea></label>
              <label class="consent"><input type="checkbox" name="privacy_consent" required /> <span>Соглашаюсь с <a href="https://www.lenremont.ru/politika-obrabotki-personalnyh-dannyh.htm">политикой обработки персональных данных</a>.</span></label>
            </fieldset>

            <div class="lead-quiz__actions"><button class="button button--back" type="button" data-quiz-back hidden>Назад</button><button class="button button--primary" type="button" data-quiz-next>Далее <span aria-hidden="true">↘</span></button><button class="button button--primary" type="submit" data-quiz-submit hidden>Получить предварительный расчёт <span aria-hidden="true">↘</span></button></div>
            <p class="form-message" data-quiz-message aria-live="polite">Телефон нужен только для ответа по вашему сиденью. Перед публикацией подключите реальный обработчик заявки.</p>
          </form>
        </div>
      </div>
    </section>

    <section class="vehicles section" aria-labelledby="vehicles-title"><div class="container"><p class="eyebrow">ОТ ГОРОДСКОГО СКУТЕРА ДО ТЕХНИКИ ОТКРЫТОГО ТИПА</p><div class="section-head"><h2 id="vehicles-title">Какие сиденья можно показать специалисту</h2><p>Конструкция и условия эксплуатации отличаются — поэтому решение начинается с фотографии конкретного сиденья.</p></div><div class="vehicles__grid">{vehicles.map(([name, text], i) => <article class="vehicle"><span>0{i + 1}</span><h3>{name}</h3><p>{text}</p><a href="#estimate" data-cta="vehicle_types">Показать сиденье <b>↘</b></a></article>)}</div></div></section>

    <section class="portfolio section section--dark" id="portfolio" aria-labelledby="portfolio-title">
      <div class="container portfolio__intro"><div><p class="eyebrow">ИСТОРИИ ОБНОВЛЕНИЯ</p><h2 id="portfolio-title">Детали, в которых видно новое ощущение от сиденья</h2><p class="section-lead">Потяните ленту, чтобы посмотреть визуальные сценарии. Реальные кейсы с подтверждёнными фотографиями будут добавлены после получения прав на публикацию.</p></div><div class="portfolio__actions"><a class="button button--outline" href="#estimate" data-cta="portfolio">Запросить похожий результат <span aria-hidden="true">↘</span></a><div class="case-nav" aria-label="Навигация по кейсам"><button type="button" class="case-nav__button" data-case-prev>Назад</button><button type="button" class="case-nav__button" data-case-next>Далее</button></div></div></div>
      <div class="portfolio__carousel">
        <div class="swiper case-swiper" data-case-swiper aria-roledescription="carousel" aria-label="Лента визуальных сценариев">
          <div class="swiper-wrapper">
            {caseStudies.map((caseStudy) => <article class="swiper-slide case-card" data-case-card style="--compare-position: 50%;"><div class="case-card__media"><img class="case-card__image" src={caseStudy.after} alt={`Визуал концепции: ${caseStudy.title}`} loading="lazy" width="1536" height="1024" /><div class="case-card__before"><img class="case-card__image" src={caseStudy.before} alt="" loading="lazy" width="1536" height="1024" /></div><span class="case-card__label case-card__label--before">Исходная точка</span><span class="case-card__label case-card__label--after">Концепт</span><input class="case-card__range" type="range" min="18" max="82" value="50" aria-label={`Сравнение визуалов: ${caseStudy.title}`} /></div><div class="case-card__body"><p>{caseStudy.tags}</p><span>{caseStudy.number} / 03</span><h3>{caseStudy.title}</h3><div><b>Сценарий</b><p>{caseStudy.text}</p></div></div></article>)}
          </div>
          <div class="case-swiper__pagination" data-case-pagination></div>
        </div>
      </div>
    </section>

    <section class="options section" aria-labelledby="options-title"><div class="container"><p class="eyebrow">РАБОТАЕМ С ЗАДАЧЕЙ, А НЕ ТОЛЬКО С ВЕРХНИМ СЛОЕМ</p><h2 id="options-title">Что обсудим вместе с перетяжкой</h2><div class="options__grid"><article><span class="option-number">01</span><h3>Восстановить</h3><p>Если обивка изношена или повреждена, сначала оценим состояние сиденья и применимый объем работ.</p></article><article><span class="option-number">02</span><h3>Изменить посадку</h3><p>Вопросы формы и наполнителя решаются только после осмотра и подтверждения возможности доработки.</p></article><article><span class="option-number">03</span><h3>Изменить дизайн</h3><p>Фактуру, цвет, сочетания и строчку согласуем заранее — до начала пошива.</p></article></div></div></section>

    <section class="materials section"><div class="container materials__grid"><div class="materials__texture"><img src="/assets/moto-seat/materials-staging.png" alt="Staging-визуал образцов черного, коричневого и перфорированного обивочного материала" loading="lazy" width="1536" height="1024" /><span>ВИЗУАЛ КОНЦЕПЦИИ · MATERIAL SELECT</span></div><div><p class="eyebrow">СМОТРИМ НА ФАКТУРУ И УСЛОВИЯ ЭКСПЛУАТАЦИИ</p><h2>Материал подбираем после осмотра и уточнения сценария езды</h2><p class="section-lead">Для открытой техники важны фактура, эластичность, стойкость поверхности и совместимость со сложной формой. Не публикуем названия коллекций и свойства, пока они не подтверждены техническими данными.</p><ul class="check-list"><li>Показываем физические образцы при согласовании</li><li>Проверяем сочетание материалов и швов</li><li>Финальный оттенок выбирают не по экрану</li></ul></div></div></section>

    <section class="pricing section" aria-labelledby="pricing-title"><div class="container pricing__grid"><div><p class="eyebrow">БЕЗ АБСТРАКТНОЙ «ДОГОВОРНОЙ ЦЕНЫ»</p><h2 id="pricing-title">Сначала поймем состав работ — затем назовем стоимость</h2></div><div><p>На цену влияют размер и форма сиденья, состояние основания и наполнителя, выбранный материал, количество деталей и сложность строчки.</p><p>Предварительно оцениваем по фото. Окончательную стоимость называют после осмотра и выбора материала — до начала работ.</p><a class="button button--primary" href="#estimate" data-cta="pricing">Рассчитать по фото <span aria-hidden="true">↘</span></a></div></div></section>

    <section class="process section section--dark" id="process" aria-labelledby="process-title"><div class="container"><p class="eyebrow">ВЫ КОНТРОЛИРУЕТЕ РЕЗУЛЬТАТ ДО НАЧАЛА ПОШИВА</p><h2 id="process-title">Как проходит перетяжка сиденья</h2><ol class="timeline">{process.map((step, i) => <li><span>0{i + 1}</span><p>{step}</p></li>)}</ol></div></section>

    <section class="logistics section"><div class="container logistics__grid"><div><p class="eyebrow">ВЫБЕРИТЕ УДОБНЫЙ СПОСОБ ПЕРЕДАЧИ</p><h2>Способ передачи согласуем заранее</h2><p class="section-lead">Можно обсудить доставку техники в мастерскую и обратно. Точный адрес приема снятых сидений и применимость доставки к ним требуют отдельного подтверждения — поэтому в этой версии мы их не выдумываем.</p></div><div class="logistics__call"><span>КОНСУЛЬТАЦИЯ</span><a href="tel:+78123444444">{phone}</a><p>Диспетчерская работает круглосуточно, без выходных.</p><a href="#estimate" data-cta="logistics">Или отправить фото →</a></div></div></section>

    <section class="quality section"><div class="container quality__grid"><div><span class="quality__mark">01<br/>YEAR</span><p class="eyebrow">КОНТРОЛЬ СОГЛАСОВАННОГО РЕЗУЛЬТАТА</p><h2>Проверяем посадку чехла, швы и согласованный дизайн</h2></div><ul class="check-list"><li>Состав работ зафиксирован</li><li>Материал и дизайн согласованы</li><li>Заказ проверен перед выдачей</li><li>Гарантия 1 год заявлена на официальной странице; условия уточняются в документах к заказу</li></ul></div></section>

    <section class="faq section" aria-labelledby="faq-title"><div class="container faq__inner"><p class="eyebrow">КОРОТКО О ГЛАВНОМ</p><h2 id="faq-title">Частые вопросы</h2>{faqs.map(([question, answer], i) => <details class="faq__item" open={i === 0}><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>

