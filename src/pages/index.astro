---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../sections/HeroSection.astro";
import HeroMessengers from "../sections/HeroMessengers.astro";
import ProofSection from "../sections/ProofSection.astro";

import VehicleSection from "../sections/VehicleSection.astro";
import PortfolioSection from "../sections/PortfolioSection.astro";
import ServiceOptionsSection from "../sections/ServiceOptionsSection.astro";
import MaterialsSection from "../sections/MaterialsSection.astro";
import PricingSection from "../sections/PricingSection.astro";
import ProcessSection from "../sections/ProcessSection.astro";
import LogisticsSection from "../sections/LogisticsSection.astro";
import QualitySection from "../sections/QualitySection.astro";
import FaqSection from "../sections/FaqSection.astro";
import ContactSection from "../sections/ContactSection.astro";
import MobileActions from "../components/MobileActions.astro";
import ServiceSchema from "../sections/ServiceSchema.astro";
import CallbackModal from "../components/CallbackModal.astro";
---

<BaseLayout
  title="Перетяжка сидений мотоциклов и квадроциклов в СПб | Ленремонт"
  description="Перетяжка и ремонт сидений мотоциклов, квадроциклов и другой мототехники в Санкт-Петербурге. Ответьте на четыре вопроса и выберите удобный способ обратной связи."
  canonical={Astro.site ? new URL("/", Astro.site).href : "https://www.lenremont.ru/peretyazhka-sidenya-motoczikla.htm"}
>
  <a class="skip" href="#quiz">Перейти к подбору</a>
  <main id="top">
    <HeroSection />
    <HeroMessengers />
    <ProofSection />
    <VehicleSection />
    <PortfolioSection />
    <ServiceOptionsSection />
    <MaterialsSection />
    <PricingSection />
    <ProcessSection />
    <LogisticsSection />
    <QualitySection />
    <FaqSection />
    <ContactSection />
  </main>
  <ServiceSchema />
  <CallbackModal />
  <MobileActions />
</BaseLayout>
