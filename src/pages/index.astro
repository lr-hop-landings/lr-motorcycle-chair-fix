  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script>
    import Swiper from 'swiper';
    import { A11y, Navigation, Pagination } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/pagination';

    const form = document.querySelector('.lead-quiz');
    const output = document.querySelector('#file-output');
    const photos = document.querySelector('#photos');
    const source = document.querySelector('input[name="cta_source"]');
    const estimateTitle = document.querySelector('#estimate-title');
    document.querySelectorAll('[data-cta]').forEach((link) => link.addEventListener('click', () => { if (source) source.value = link.dataset.cta || 'direct'; window.setTimeout(() => estimateTitle?.focus({ preventScroll: true }), 350); }));
    photos?.addEventListener('change', () => { const count = photos.files?.length || 0; output.textContent = count ? `Выбрано: ${count}` : 'Файлы не выбраны'; });
    if (form) {
      const steps = Array.from(form.querySelectorAll('[data-quiz-step]'));
      const counter = form.querySelector('[data-quiz-counter]');
      const progress = form.querySelector('[data-quiz-progress]');
      const message = form.querySelector('[data-quiz-message]');
      const back = form.querySelector('[data-quiz-back]');
      const next = form.querySelector('[data-quiz-next]');
      const submit = form.querySelector('[data-quiz-submit]');
      let activeStep = 0;
      const showStep = (index) => {
        activeStep = index;
        steps.forEach((step, stepIndex) => { const current = stepIndex === index; step.hidden = !current; step.classList.toggle('is-active', current); });
        counter.textContent = `ВЫ ПРОШЛИ ${index + 1} ИЗ ${steps.length} ШАГОВ`;
        progress.style.width = `${((index + 1) / steps.length) * 100}%`;
        back.hidden = index === 0;
        next.hidden = index === steps.length - 1;
        submit.hidden = index !== steps.length - 1;
        message.textContent = index === steps.length - 1 ? 'Телефон нужен только для ответа по вашему сиденью. Перед публикацией подключите реальный обработчик заявки.' : '';
      };
      const validateStep = (step) => {
        const count = photos?.files?.length || 0;
        if (step.contains(photos) && (count < 2 || count > 4)) { message.textContent = 'Добавьте от 2 до 4 фотографий, чтобы перейти дальше.'; return false; }
        const fields = Array.from(step.querySelectorAll('input[required], select[required], textarea[required]'));
        const valid = fields.every((field) => field.checkValidity());
        if (!valid) { message.textContent = 'Выберите вариант или заполните обязательное поле.'; const invalid = fields.find((field) => !field.checkValidity()); invalid?.reportValidity(); return false; }
        return true;
      };
      next?.addEventListener('click', () => { if (!validateStep(steps[activeStep])) return; showStep(Math.min(activeStep + 1, steps.length - 1)); steps[activeStep].querySelector('legend')?.focus?.(); });
      back?.addEventListener('click', () => showStep(Math.max(activeStep - 1, 0)));
      form.addEventListener('submit', (event) => { event.preventDefault(); if (!validateStep(steps[activeStep]) || !form.checkValidity()) { message.textContent = 'Проверьте обязательные поля на этом шаге.'; return; } message.textContent = 'Форма готова к отправке. Для доставки заявки подключите утверждённый CRM или серверный обработчик.'; });
      showStep(0);
    }
    document.querySelectorAll('[data-case-card]').forEach((card) => { const range = card.querySelector('.case-card__range'); range?.addEventListener('input', () => card.style.setProperty('--compare-position', `${range.value}%`)); });
    const caseSwiper = document.querySelector('[data-case-swiper]');
    if (caseSwiper) new Swiper(caseSwiper, { modules: [A11y, Navigation, Pagination], slidesPerView: 'auto', spaceBetween: 22, grabCursor: true, navigation: { prevEl: '[data-case-prev]', nextEl: '[data-case-next]' }, pagination: { el: '[data-case-pagination]', clickable: true }, a11y: { prevSlideMessage: 'Предыдущий кейс', nextSlideMessage: 'Следующий кейс' }, breakpoints: { 760: { spaceBetween: 28 } } });
    const heroActions = document.querySelector('.hero__actions');
    if (heroActions && !document.querySelector('.hero__social')) {
      const heroSocial = document.createElement('div');
      heroSocial.className = 'hero__social';
      heroSocial.setAttribute('aria-label', 'Написать в мессенджер');
      heroSocial.innerHTML = '<div class="hero__social-label">Или напишите нам в мессенджере</div><div class="hero__social-links"><a class="hero__social-link hero__social-link--tg" href="https://telegram.me/lenremont_bot" target="_blank" rel="noopener noreferrer"><span>Telegram</span><img class="hero__social-qr" src="/assets/social/lr-qr-tg.webp" alt="QR-код Telegram" width="196" height="196" /></a><a class="hero__social-link hero__social-link--vk" href="https://vk.ru/lenremont" target="_blank" rel="noopener noreferrer"><span>ВКонтакте</span><img class="hero__social-qr" src="/assets/social/lr-qr-vk.webp" alt="QR-код ВКонтакте" width="196" height="196" /></a><a class="hero__social-link hero__social-link--max" href="https://max.ru/id471902475874_3_bot" target="_blank" rel="noopener noreferrer"><span>MAX</span><img class="hero__social-qr" src="/assets/social/lr-qr-max.webp" alt="QR-код MAX" width="196" height="196" /></a></div><div class="hero__social-label">Или звоните по телефону</div><a class="hero__social-phone" href="tel:+78123444444">+7 (812) 344-44-44</a>';
      heroActions.insertAdjacentElement('afterend', heroSocial);
    }
    const sticky = document.querySelector('.sticky-cta');
    const heroCta = document.querySelector('[data-cta="hero"]');
    if (sticky && heroCta && 'IntersectionObserver' in window) new IntersectionObserver(([entry]) => sticky.classList.toggle('is-visible', !entry.isIntersecting), { threshold: .1 }).observe(heroCta);
  </script>
</BaseLayout>
