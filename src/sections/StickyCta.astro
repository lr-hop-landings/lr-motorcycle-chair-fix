<nav class="sticky-cta" aria-label="Быстрые действия"><a href="#estimate" data-cta="sticky">Расчёт</a><a href="tel:+78123444444">Позвонить</a></nav>
<script>
  const sticky = document.querySelector('.sticky-cta');
  const heroCta = document.querySelector('[data-cta="hero"]');
  if (sticky && heroCta && 'IntersectionObserver' in window) new IntersectionObserver(([entry]) => sticky.classList.toggle('is-visible', !entry.isIntersecting), { threshold: 0.1 }).observe(heroCta);
</script>
<style>
  .sticky-cta { display: none; }
  @media (max-width: 640px) { .sticky-cta { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 9px; padding: 9px 12px calc(9px + env(safe-area-inset-bottom)); border-top: 1px solid #d2d3d5; background: rgb(255 255 255 / 95%); transform: translateY(110%); transition: transform 0.2s ease; } .sticky-cta.is-visible { transform: translateY(0); } .sticky-cta a { display: grid; min-height: 48px; place-items: center; border-radius: 7px; color: var(--white); background: var(--blue); font-size: 14px; font-weight: 800; text-decoration: none; } .sticky-cta a + a { background: var(--ink); } }
</style>
