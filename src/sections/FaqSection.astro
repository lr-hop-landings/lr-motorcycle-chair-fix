---
import { commonQuestions, type VehiclePage } from "../data/vehicles";
interface Props { vehicle?: VehiclePage; }
const { vehicle } = Astro.props;
const questions = vehicle ? [...vehicle.faq, ...commonQuestions] : [
  {
    "question": "Можно узнать цену по фото?",
    "answer": "Фотографии помогают определить задачу и начать оценку. Окончательная стоимость зависит от материала и объёма работ. Если нужно проверить состояние под чехлом, потребуется осмотр."
  },
  {
    "question": "Что сфотографировать?",
    "answer": "Сиденье целиком сверху и сбоку, затем повреждение крупным планом. Напишите модель техники. Для нового дизайна добавьте понравившийся пример."
  },
  {
    "question": "Новая обивка сделает сиденье удобнее?",
    "answer": "Сначала нужно понять причину неудобства. Поверхность чехла, форма и наполнитель требуют разных решений. В подборе можно описать, что мешает именно вам."
  },
  {
    "question": "Нужно ли снимать сиденье?",
    "answer": "Перед передачей уточните способ приёма для вашей техники. В обращении укажите, снято сиденье или пока установлено."
  },
  {
    "question": "Сколько длится работа?",
    "answer": "Срок согласовываем для конкретного заказа с учётом материала и объёма изменений. Если сиденье нужно к поездке, сразу укажите дату."
  },
  {
    "question": "Какие материалы можно выбрать?",
    "answer": "Подберём материал под конструкцию сиденья и условия эксплуатации. До начала работ покажем образцы, согласуем фактуру, цвет и строчку."
  },
  {
    "question": "Есть ли гарантия?",
    "answer": "Гарантия на перетяжку — 1 год. Объём гарантии и её условия фиксируем в документах на заказ."
  },
  {
    "question": "Как передать сиденье?",
    "answer": "После предварительной оценки согласуем место приёма и способ передачи. Возможность и стоимость доставки уточним по вашему адресу и габаритам сиденья или техники."
  }
];
---
<section class="section" id="faq">
<div class="wrap faq-layout">
<div>
<div class="eyebrow">Перед обращением</div>
<h2>Остались<br>вопросы?</h2>
<p>Вот что полезно знать до передачи сиденья.</p>
</div>
<div>
{questions.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}
</div>
</div>
</section>
