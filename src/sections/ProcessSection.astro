---
import type { VehiclePage } from "../data/vehicles";

interface Props {
  vehicle?: VehiclePage;
}
const { vehicle } = Astro.props;

const defaultLogistics =
  "Можно передать снятое сиденье или обсудить доставку техники. Адрес, габариты и способ приёма согласуем заранее.";
const steps = [
  {
    number: "01",
    icon: "chat",
    title: "Опишите задачу",
    text: "Ответьте на несколько вопросов и выберите удобный способ связи.",
  },
  {
    number: "02",
    icon: "photo",
    title: "Покажите сиденье",
    text: "Пришлите общий вид сверху и сбоку, повреждения и пример желаемого дизайна.",
  },
  {
    number: "03",
    icon: "route",
    title: "Согласуем передачу",
    text: vehicle?.logistics ?? defaultLogistics,
  },
  {
    number: "04",
    icon: "material",
    title: "Подберём материал",
    text: "Покажем реальные образцы, обсудим цвет, фактуру, кант и рисунок строчки.",
  },
  {
    number: "05",
    icon: "check",
    title: "Сошьём и проверим",
    text: "Проверим посадку чехла, края, швы и соответствие согласованному решению.",
  },
  {
    number: "06",
    icon: "seat",
    title: "Получите готовое сиденье",
    text: "Передадим заказ с зафиксированными условиями и гарантией на выполненную работу.",
  },
];
---

<section
  class="wrap process section--dark"
  id="process"
  aria-labelledby="process-title"
>
  <div class="process__head">
    <div>
      <p class="eyebrow">КАК ВСЁ ПРОХОДИТ</p>
      <h2 id="process-title">От вашей идеи<br />к готовому сиденью</h2>
    </div>
    <p class="process__lead">
      Шесть понятных шагов — от первого фото до проверки посадки и выдачи
      заказа.
    </p>
  </div>

  <ol class="timeline">
    {
      steps.map((step) => (
        <li>
          <div class="timeline__topline">
            <span class="timeline__number">{step.number}</span>
            <span class="timeline__icon" aria-hidden="true">
              {step.icon === "chat" && (
                <svg viewBox="0 0 24 24">
                  <path d="M5 5.5h14v9H11l-4.5 4v-4H5z" />
                  <path d="M8 9h8M8 12h5" />
                </svg>
              )}
              {step.icon === "photo" && (
                <svg viewBox="0 0 24 24">
                  <rect x="4" y="6" width="16" height="13" rx="2" />
                  <path d="m7 15 2.5-2.5L12 15l2-2 3 3M9 10h.01" />
                </svg>
              )}
              {step.icon === "route" && (
                <svg viewBox="0 0 24 24">
                  <circle cx="6" cy="17" r="2" />
                  <circle cx="18" cy="7" r="2" />
                  <path d="M8 17h3a3 3 0 0 0 3-3v-1a3 3 0 0 1 3-3h1" />
                </svg>
              )}
              {step.icon === "material" && (
                <svg viewBox="0 0 24 24">
                  <path d="m5 7 7-3 7 3-7 3zM5 7v6l7 3 7-3V7M5 13v5l7 3 7-3v-5" />
                  <path d="M12 10v6" />
                </svg>
              )}
              {step.icon === "check" && (
                <svg viewBox="0 0 24 24">
                  <path d="m5 12 4 4L19 6" />
                  <path d="M12 3a9 9 0 1 0 9 9" />
                </svg>
              )}
              {step.icon === "seat" && (
                <svg viewBox="0 0 24 24">
                  <path d="M7 5v8a4 4 0 0 0 4 4h7M7 5h4a3 3 0 0 1 3 3v1M5 19h14M9 17v2" />
                </svg>
              )}
            </span>
          </div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .process {
    margin-top: 94px;
    padding: clamp(30px, 5vw, 64px);
    border-radius: 28px;
    color: var(--white);
    background: var(--night);
  }
  .process .eyebrow {
    color: var(--cyan);
    margin-bottom: 20px;
  }
  .process__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 52px;
  }
  .process h2 {
    margin: 0;
  }
  .process__lead {
    max-width: 370px;
    margin: 0 0 4px;
    color: #c4d4e5;
    font-size: 17px;
    line-height: 1.55;
  }
  .timeline {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .timeline li {
    min-height: 224px;
    padding: 26px 28px 30px 0;
    border-top: 1px solid rgb(196 212 229 / 0.28);
  }
  .timeline li:nth-child(3n + 2),
  .timeline li:nth-child(3n + 3) {
    padding-left: 28px;
    border-left: 1px solid rgb(196 212 229 / 0.18);
  }
  .timeline__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .timeline__number {
    color: var(--yellow);
    font-size: 14px;
    font-weight: 850;
    letter-spacing: 0.08em;
  }
  .timeline__icon {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border: 1px solid rgb(158 228 252 / 0.45);
    border-radius: 14px;
    color: var(--cyan);
    background: rgb(158 228 252 / 0.08);
  }
  .timeline__icon svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }
  .timeline h3 {
    max-width: 260px;
    margin: 24px 0 10px;
    font-size: 22px;
    line-height: 1.12;
  }
  .timeline p {
    max-width: 300px;
    margin: 0;
    color: #c4d4e5;
    font-size: 15px;
    line-height: 1.48;
  }
  @media (max-width: 900px) {
    .timeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .timeline li:nth-child(3n + 2),
    .timeline li:nth-child(3n + 3) {
      padding-left: 0;
      border-left: 0;
    }
    .timeline li:nth-child(even) {
      padding-left: 28px;
      border-left: 1px solid rgb(196 212 229 / 0.18);
    }
  }
  @media (max-width: 760px) {
    .process__head {
      display: block;
      margin-bottom: 38px;
    }
    .process__lead {
      margin-top: 18px;
      font-size: 16px;
    }
    .timeline {
      grid-template-columns: 1fr;
    }
    .timeline li,
    .timeline li:nth-child(even) {
      min-height: 0;
      padding: 24px 0 28px;
      border-left: 0;
    }
    .timeline h3 {
      margin-top: 18px;
      font-size: 22px;
    }
    .timeline p {
      max-width: 540px;
      font-size: 15px;
    }
  }
</style>
