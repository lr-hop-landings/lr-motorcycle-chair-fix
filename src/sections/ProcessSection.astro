---
const steps = [
  ["Опишите задачу", "Ответьте на четыре вопроса и выберите удобный способ обратной связи."],
  ["Покажите сиденье", "Отправьте фотографии в мессенджере. Специалист обсудит вариант и предварительную стоимость."],
  ["Передайте сиденье", "Согласуем приём сиденья или техники и возможность доставки."],
  ["Согласуйте детали", "После осмотра выберем материал, дизайн, окончательную стоимость и срок."],
  ["Примите работу", "Проверим посадку чехла, швы и детали. Вы получите готовое сиденье и документы на заказ."]
];
---
<section class="wrap process section--dark" id="process" aria-labelledby="process-title">
  <p class="eyebrow">КАК ВСЁ ПРОХОДИТ</p>
  <h2 id="process-title">От вашей идеи<br />к готовому сиденью</h2>
  <ol class="timeline">{steps.map(([title, text], index) => <li><span>0{index + 1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol>
</section>
<style>
  .process { margin-block: 20px 40px; }
  .process h2 { margin-bottom: 42px; }
  .timeline { display: grid; grid-template-columns: repeat(5, 1fr); margin: 0; padding: 0; list-style: none; }
  .timeline li { position: relative; min-height: 185px; padding: 42px 24px 0 0; border-top: 1px solid #65676b; }
  .timeline li::before { position: absolute; top: -5px; left: 0; width: 9px; height: 9px; border-radius: 50%; background: var(--orange); content: ""; }
  .timeline span { color: var(--yellow); font-size: 16px; font-weight: 800; }
  .timeline h3 { margin-top: 18px; font-size: 23px; }
  .timeline p { margin-top: 14px; color: #c4d4e5; font-size: 16px; }
  .timeline li::before { background: var(--yellow); }
  @media (max-width: 900px) { .timeline { grid-template-columns: 1fr; } .timeline li { min-height: unset; padding: 0 0 32px 36px; border-top: 0; border-left: 1px solid #65676b; } .timeline li::before { top: 5px; left: -5px; } .timeline p { max-width: 540px; margin: 9px 0 0; } }
</style>
