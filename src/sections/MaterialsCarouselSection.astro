---
import ButtonLink from "../components/ButtonLink.astro";
import type { VehiclePage } from "../data/vehicles";

interface Props {
  vehicle?: VehiclePage;
}

const { vehicle } = Astro.props;
const selectionPoints = vehicle?.materials.details ?? [
  { title: "Сцепление", text: "Насколько свободно нужно двигаться по сиденью." },
  { title: "Уход", text: "Как часто техника бывает под дождём, в грязи и на мойке." },
  { title: "Внешний вид", text: "Цвет, фактура, кант и рисунок строчки." },
];

const materials = [
  {
    kind: "Универсальный вариант",
    title: "Автовинил",
    note: "Практичное покрытие для регулярной эксплуатации. Легко очищается и доступно в разных фактурах.",
    fit: "город, туринг, скутер",
    image: "/assets/reference/materials/01-vinyl.webp",
    alt: "Фактура матового чёрного автовинила",
  },
  {
    kind: "Акцент на внешнем виде",
    title: "Натуральная кожа",
    note: "Живая фактура и естественный рисунок. Её выбирают прежде всего ради характера и тактильных ощущений.",
    fit: "круизер, кастом, классика",
    image: "/assets/reference/materials/02-leather.webp",
    alt: "Фактура кожи оттенка коньяк с прошитым краем",
  },
  {
    kind: "Больше сцепления",
    title: "Микрозамша",
    note: "Шероховатая поверхность помогает меньше скользить, но требует более внимательного ухода.",
    fit: "спорт, эндуро, питбайк",
    image: "/assets/reference/materials/03-microsuede.webp",
    alt: "Фактура тёмной микрозамши с красной строчкой",
  },
  {
    kind: "Вставка, а не основа",
    title: "Перфорированный винил",
    note: "Визуально разделяет посадочные зоны и добавляет фактуру. Используется вместе с основным покрытием.",
    fit: "туринг, максискутер",
    image: "/assets/reference/materials/04-perforated.webp",
    alt: "Перфорированный чёрный материал с ровной строчкой",
  },
  {
    kind: "Для открытой техники",
    title: "Морской винил",
    note: "Плотное покрытие для техники, которая часто бывает на улице. Свойства конкретного варианта проверяем по образцу.",
    fit: "квадроцикл, багги, скутер",
    image: "/assets/reference/materials/05-marine-fabric.webp",
    alt: "Слои плотного винила оттенков графит и тёмно-синий",
  },
  {
    kind: "Оформление",
    title: "Кант и строчка",
    note: "Не заменяют основное покрытие, а подчёркивают форму сиденья и связывают выбранные цвета.",
    fit: "любое сиденье",
    image: "/assets/reference/materials/06-piping-thread.webp",
    alt: "Образцы канта и контрастных нитей рядом с чёрной обивкой",
  },
];
---

<section class="materials-carousel section" id="materials" aria-labelledby="materials-title">
  <div class="container materials-carousel__intro">
    <div class="materials-carousel__copy">
      <p class="eyebrow">ВЫБОР МАТЕРИАЛА</p>
      <h2 id="materials-title">Материал под задачу, отделка — под стиль</h2>
      <p class="section-lead">
        {vehicle?.materials.text ?? "Сравните варианты по сцеплению, уходу и назначению. Финальный оттенок и фактуру показываем на физических образцах."}
      </p>
    </div>

    <div class="materials-carousel__criteria" aria-label="Что учитываем при подборе">
      {selectionPoints.map(({ title, text }, index) => (
        <div class="material-criterion">
          <span aria-hidden="true">0{index + 1}</span>
          <div>
            <strong>{title}</strong>
            <p>{text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="materials-carousel__carousel">
    <div class="swiper materials-swiper" data-materials-swiper aria-roledescription="carousel" aria-label="Варианты материалов и отделки">
      <div class="swiper-wrapper">
        {materials.map((material, index) => (
          <article class="swiper-slide material-card">
            <div class="material-card__visual">
              <img src={material.image} alt={material.alt} width="1448" height="1086" loading="lazy" />
              <span class="material-card__number" aria-hidden="true">0{index + 1}</span>
            </div>
            <div class="material-card__caption">
              <p class="material-card__kind">{material.kind}</p>
              <h3>{material.title}</h3>
              <p class="material-card__note">{material.note}</p>
              <p class="material-card__fit"><span>Подходит</span>{material.fit}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <div class="container materials-carousel__action">
    <p><strong>Не нужно выбирать заранее.</strong> Пришлите фото техники и расскажите, как её используете — предложим подходящие образцы.</p>
    <ButtonLink href="#quiz" dataCta="materials">Подобрать материал</ButtonLink>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { A11y } from "swiper/modules";
  import "swiper/css";

  const hopRoot = document.getElementById("hop-gutenberg") || document;
  const materialsSwiper = hopRoot.querySelector("[data-materials-swiper]");
  if (materialsSwiper) {
    new Swiper(materialsSwiper, {
      modules: [A11y],
      slidesPerView: 1.08,
      spaceBetween: 12,
      grabCursor: true,
      a11y: {
        prevSlideMessage: "Предыдущий материал",
        nextSlideMessage: "Следующий материал",
      },
      breakpoints: {
        768: {
          slidesPerView: "auto",
          spaceBetween: 18,
        },
      },
    });
  }
</script>

<style>
  .materials-carousel {
    overflow: hidden;
    background:
      linear-gradient(135deg, rgb(9 39 71 / 4%), transparent 36%),
      var(--white);
  }
  .materials-carousel__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(430px, 0.78fr);
    gap: clamp(48px, 7vw, 110px);
    align-items: end;
    margin-bottom: 42px;
  }
  .materials-carousel__copy h2 {
    max-width: 760px;
    margin: 18px 0 0;
  }
  .materials-carousel__copy .section-lead {
    max-width: 670px;
    margin-bottom: 0;
  }
  .materials-carousel__criteria {
    border-top: 1px solid var(--line);
  }
  .material-criterion {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 12px;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
  }
  .material-criterion > span {
    padding-top: 2px;
    color: var(--blue);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .material-criterion strong {
    display: block;
    margin-bottom: 3px;
    font-size: 15px;
  }
  .material-criterion p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.4;
  }
  .materials-carousel__carousel {
    width: min(var(--container-width), calc(100% - var(--gutter) * 2));
    margin-inline: auto;
  }
  .materials-swiper {
    overflow: visible;
  }
  .materials-swiper .swiper-slide {
    width: clamp(302px, 27vw, 370px);
    height: auto;
  }
  .material-card {
    overflow: hidden;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
  }
  .material-card__visual {
    position: relative;
    overflow: hidden;
  }
  .material-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.45s ease;
  }
  .material-card:hover img {
    transform: scale(1.025);
  }
  .material-card__number {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: 50%;
    color: var(--white);
    background: rgb(9 39 71 / 70%);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.06em;
    backdrop-filter: blur(8px);
  }
  .material-card__caption {
    display: flex;
    min-height: 264px;
    flex-direction: column;
    padding: 20px 20px 22px;
  }
  .material-card__kind {
    margin: 0 0 12px;
    color: var(--blue);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .material-card__caption h3 {
    margin: 0 0 10px;
    font-size: 23px;
  }
  .material-card__note {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.48;
  }
  .material-card__fit {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 10px;
    margin: auto 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-size: 13px;
    line-height: 1.4;
  }
  .material-card__fit span {
    color: var(--muted);
  }
  .materials-carousel__action {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: center;
    margin-top: 34px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .materials-carousel__action p {
    max-width: 720px;
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.5;
  }
  .materials-carousel__action strong {
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .materials-carousel__intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
    }
    .materials-carousel__criteria {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 0;
    }
    .material-criterion {
      grid-template-columns: minmax(0, 1fr);
      padding: 14px;
      border: 1px solid var(--line);
      border-right: 0;
    }
    .material-criterion:last-child {
      border-right: 1px solid var(--line);
    }
  }

  @media (max-width: 767px) {
    .materials-carousel__intro {
      gap: 24px;
      margin-bottom: 28px;
    }
    .materials-carousel__copy .section-lead {
      font-size: 15px;
    }
    .materials-carousel__criteria {
      grid-template-columns: minmax(0, 1fr);
    }
    .material-criterion {
      grid-template-columns: 30px minmax(0, 1fr);
      padding: 12px 0;
      border-width: 0 0 1px;
    }
    .material-criterion:first-child {
      border-top: 1px solid var(--line);
    }
    .material-criterion:last-child {
      border-right: 0;
    }
    .materials-carousel__carousel {
      width: calc(100% - var(--gutter) * 2);
      margin-inline: auto;
    }
    .materials-swiper .swiper-slide {
      width: calc(100vw - var(--gutter) * 2 - 12px);
    }
    .material-card {
      border-radius: 18px;
    }
    .material-card__caption {
      min-height: 244px;
      padding: 18px 16px 20px;
    }
    .material-card__caption h3 {
      font-size: 21px;
    }
    .materials-carousel__action {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      margin-top: 26px;
    }
    .materials-carousel__action :global(.button) {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .material-card img {
      transition: none;
    }
  }
</style>
