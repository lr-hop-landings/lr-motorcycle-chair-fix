---
import type { VehiclePage } from "../data/vehicles";
interface Props {
  vehicle?: VehiclePage;
}
const { vehicle } = Astro.props;
---

<section
  class:list={["section", { "solutions--vehicle": vehicle }]}
  id="solutions"
>
  <div class="wrap">
    <div class="section-top">
      <h2>Что можно изменить<br />в вашем сиденье</h2>
      <p>Начинаем с нужного результата. Под него определяем объём работ.</p>
    </div>
    <div class="approaches">
      <article class="approach">
        <div class="diagram" aria-hidden="true">
          <span class="index">01 / ОБИВКА</span>
          <svg viewBox="0 0 240 130">
            <path
              d="M23 88c8-18 17-18 32-12 22 9 37 1 54-17s26-31 48-28l60 15-8 25-54 5c-20 3-32 18-63 21-26 3-49 0-69-9Z"
            ></path>
            <path stroke-dasharray="4 5" d="m35 86 36 5 33-8 37-33 63 10"
            ></path>
            <path d="m80 48 12-10-1 14 12-9m-56 5 8-12"></path>
          </svg>
        </div>
        <div class="approach-body">
          <h3>Вернуть аккуратный вид</h3>
          <p>
            {
              vehicle?.solutions[0] ??
                "Заменить чехол с трещинами, разрывами и потёртостями. Если посадка устраивает, начните с обивки."
            }
          </p>
          <a class="text-link" href="#quiz" data-intent="restore"
            >Подобрать восстановление <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
      <article class="approach">
        <div class="diagram" aria-hidden="true">
          <span class="index">02 / ДИЗАЙН</span>
          <svg viewBox="0 0 240 130">
            <path
              d="M23 88c8-18 17-18 32-12 22 9 37 1 54-17s26-31 48-28l60 15-8 25-54 5c-20 3-32 18-63 21-26 3-49 0-69-9Z"
            ></path>
            <path
              d="m95 73 13 11m-1-23 16 11m-4-24 17 12m-3-23 18 14m-62 31 6 7"
            ></path>
            <path stroke="#dcaa00" stroke-width="4" d="m156 39 51 13"></path>
          </svg>
        </div>
        <div class="approach-body">
          <h3>Добавить свой характер</h3>
          <p>
            {
              vehicle?.solutions[1] ??
                "Выбрать другой цвет, фактуру и рисунок швов. Пришлите пример или расскажите, каким видите результат."
            }
          </p>
          <a class="text-link" href="#quiz" data-intent="design"
            >Обсудить новый дизайн <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
      <article class="approach">
        <div class="diagram" aria-hidden="true">
          <span class="index">03 / ПОСАДКА</span>
          <svg viewBox="0 0 240 130">
            <path
              d="M23 88c8-18 17-18 32-12 22 9 37 1 54-17s26-31 48-28l60 15-8 25-54 5c-20 3-32 18-63 21-26 3-49 0-69-9Z"
            ></path>
            <path stroke-dasharray="3 5" d="M28 101c75 23 107-21 132-17l45-5"
            ></path>
            <path d="M62 26v29m-6-6 6 6 6-6m98 49v19m-6-6 6 6 6-6"></path>
          </svg>
        </div>
        <div class="approach-body">
          <h3>Разобраться с неудобством</h3>
          <p>
            {
              vehicle?.solutions[2] ??
                "Скользко, жёстко или не подходит форма? Опишите, что мешает: новый чехол и изменение посадки решают разные задачи."
            }
          </p>
          <a class="text-link" href="#quiz" data-intent="comfort"
            >Описать мою ситуацию <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .solutions--vehicle .diagram {
    display: none;
  }
  .solutions--vehicle .approach {
    display: flex;
  }
  .solutions--vehicle .approach-body {
    padding-top: 30px;
  }
</style>
