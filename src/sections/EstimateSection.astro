---
import EstimateQuiz from "../components/EstimateQuiz.astro";
---

<section class="estimate section" id="estimate" aria-labelledby="estimate-title" tabindex="-1">
  <div class="container estimate__form-wrap">
    <header class="quiz-header">
      <p class="quiz-header__badge"><span aria-hidden="true">◷</span> Расчёт за 2 минуты</p>
      <h2 id="estimate-title">Узнайте предварительную стоимость перетяжки сиденья</h2>
      <p class="section-lead">Ответьте на пять коротких вопросов. Точные размеры не понадобятся — мастер разберётся по вашим ответам.</p>
    </header>
    <EstimateQuiz prefix="inline" />
  </div>
</section>

<dialog class="quiz-modal" data-quiz-modal aria-label="Расчёт перетяжки сиденья">
  <div class="quiz-modal__dialog">
    <button class="quiz-modal__close" type="button" data-quiz-modal-close aria-label="Закрыть квиз">×</button>
    <EstimateQuiz prefix="modal" />
  </div>
</dialog>

<script>
  const modal = document.querySelector('[data-quiz-modal]');

  const formatRussianPhone = (rawDigits) => {
    if (!rawDigits) return '';
    let localDigits = rawDigits;
    if (localDigits.startsWith('7') || localDigits.startsWith('8')) {
      localDigits = localDigits.slice(1);
    }
    localDigits = localDigits.slice(0, 10);

    if (localDigits.length === 0) {
      return (rawDigits.startsWith('7') || rawDigits.startsWith('8')) ? '+7 (' : '';
    }

    let formatted = '+7 (' + localDigits.slice(0, 3);
    if (localDigits.length >= 3) {
      formatted += ') ' + localDigits.slice(3, 6);
    }
    if (localDigits.length >= 6) {
      formatted += '-' + localDigits.slice(6, 8);
    }
    if (localDigits.length >= 8) {
      formatted += '-' + localDigits.slice(8, 10);
    }
    return formatted;
  };

  const getCursorPositionAfterDigits = (formatted, targetDigits) => {
    if (targetDigits <= 0) return 0;
    let count = 0;
    for (let i = 0; i < formatted.length; i++) {
      if (/\d/.test(formatted[i])) {
        count++;
        if (count === targetDigits) {
          let next = i + 1;
          while (next < formatted.length && (formatted[next] === ')' || formatted[next] === ' ' || formatted[next] === '-')) {
            next++;
          }
          return next;
        }
      }
    }
    return formatted.length;
  };

  const validatePhone = (phoneValue) => {
    const digits = phoneValue.replace(/\D/g, '');
    if (!digits || (digits.length <= 1 && (phoneValue.startsWith('+7') || phoneValue.startsWith('8')))) {
      return { valid: false, error: 'Укажите номер телефона для связи' };
    }
    let localDigits = digits;
    if (digits.startsWith('7') || digits.startsWith('8')) {
      localDigits = digits.slice(1);
    }
    if (localDigits.length < 10) {
      return { valid: false, error: 'Введите номер телефона полностью: +7 (___) ___-__-__' };
    }
    return { valid: true, error: null, normalized: `+7${localDigits.slice(0, 10)}` };
  };

  const setupQuiz = (root) => {
    const form = root.querySelector('form');
    const steps = Array.from(root.querySelectorAll('[data-quiz-step]'));
    const progress = root.querySelector('[data-quiz-progress]');
    const progressValue = root.querySelector('[data-quiz-progress-value]');
    const progressText = root.querySelector('[data-quiz-progress-text]');
    const analysis = root.querySelector('[data-quiz-analysis]');
    const contact = root.querySelector('[data-quiz-contact]');
    const success = root.querySelector('[data-quiz-success]');
    const nameInput = form.querySelector('input[name="name"]');
    const phone = form.querySelector('input[name="phone"]');
    const contactError = contact.querySelector('[data-contact-error]');
    let activeStep = 0;
    let view = 'questions';
    let analysisTimer;
    let closeTimer;

    const updateFieldStatus = (input, isValid) => {
      if (!input) return;
      if (isValid) {
        input.classList.remove('is-invalid');
        input.setAttribute('aria-invalid', 'false');
      } else {
        input.classList.add('is-invalid');
        input.setAttribute('aria-invalid', 'true');
      }
    };

    const getStepError = (step) => {
      const selectionName = step.dataset.quizRequiresSelection;
      if (selectionName && !step.querySelector(`input[name="${selectionName}"]:checked`)) return 'Выберите хотя бы один вариант.';
      const radios = [...new Set(Array.from(step.querySelectorAll('input[type="radio"][required]')).map((input) => input.name))];
      return radios.some((name) => !step.querySelector(`input[name="${name}"]:checked`)) ? 'Выберите вариант, чтобы продолжить.' : null;
    };

    const getContactError = (showFeedback = false) => {
      const phoneVal = validatePhone(phone.value);

      if (showFeedback) {
        updateFieldStatus(phone, phoneVal.valid);
      }

      if (!phoneVal.valid) return phoneVal.error;
      return null;
    };

    const setButton = (button, valid) => {
      if (button) {
        button.disabled = !valid;
        button.setAttribute('aria-disabled', String(!valid));
      }
    };

    const render = (focus = false) => {
      steps.forEach((step, index) => {
        const current = view === 'questions' && index === activeStep;
        step.hidden = !current;
        step.classList.toggle('is-active', current);
      });
      analysis.hidden = view !== 'analysis';
      contact.hidden = view !== 'contact';
      success.hidden = view !== 'success';
      progress.hidden = view !== 'questions';
      if (view === 'questions') {
        const number = activeStep + 1;
        progress.setAttribute('aria-valuenow', String(number));
        progressValue.style.width = `${(number / steps.length) * 100}%`;
        progressText.textContent = `Шаг ${number} из ${steps.length}`;
        const step = steps[activeStep];
        step.querySelector('[data-field-error]').hidden = true;
        setButton(step.querySelector('[data-quiz-next]'), !getStepError(step));
      }
      if (view === 'contact') {
        setButton(contact.querySelector('[data-quiz-submit]'), !getContactError(false));
      }
      if (focus) window.setTimeout(() => {
        const target = view === 'questions' ? steps[activeStep].querySelector('legend') : view === 'contact' ? contact.querySelector('[data-quiz-contact-heading]') : success;
        target?.focus({ preventScroll: true });
      }, 0);
    };

    const resetQuiz = () => {
      window.clearTimeout(analysisTimer);
      window.clearTimeout(closeTimer);
      form.reset();
      activeStep = 0;
      view = 'questions';
      form.setAttribute('aria-busy', 'false');
      if (phone) {
        phone.classList.remove('is-invalid');
        phone.removeAttribute('aria-invalid');
      }
      if (contactError) {
        contactError.hidden = true;
        contactError.textContent = '';
      }
      render();
    };

    const showSuccess = () => {
      view = 'success';
      render(true);
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        resetQuiz();
        const dialog = root.closest('dialog');
        if (dialog?.open) dialog.close();
      }, 5000);
    };

    const advance = () => {
      const step = steps[activeStep];
      const error = getStepError(step);
      if (error) {
        const element = step.querySelector('[data-field-error]');
        element.textContent = error;
        element.hidden = false;
        return;
      }
      if (activeStep < steps.length - 1) {
        activeStep += 1;
        render(true);
        return;
      }
      view = 'analysis';
      form.setAttribute('aria-busy', 'true');
      render(true);
      window.clearTimeout(analysisTimer);
      analysisTimer = window.setTimeout(() => {
        view = 'contact';
        form.setAttribute('aria-busy', 'false');
        render(true);
      }, 1800);
    };

    form.addEventListener('change', (event) => {
      const field = event.target;
      if (view === 'questions') {
        const step = steps[activeStep];
        render();
        if (field.type === 'radio' && step.contains(field) && !getStepError(step)) {
          window.setTimeout(() => {
            if (view === 'questions' && steps[activeStep] === step) advance();
          }, 350);
        }
      } else if (view === 'contact') {
        render();
      }
    });

    form.querySelectorAll('[data-quiz-next]').forEach((button) => button.addEventListener('click', advance));
    form.querySelectorAll('[data-quiz-prev]').forEach((button) => button.addEventListener('click', () => {
      if (activeStep > 0) {
        activeStep -= 1;
        render(true);
      }
    }));

    phone.addEventListener('input', (event) => {
      const input = event.target;
      const raw = input.value;
      const cursorPos = input.selectionStart || 0;
      const digitsBeforeCursor = raw.slice(0, cursorPos).replace(/\D/g, '').length;
      const allDigits = raw.replace(/\D/g, '');

      const isInitialDigit = allDigits.length === 1 && !raw.startsWith('+7') && !raw.startsWith('8');
      const formatted = formatRussianPhone(allDigits);
      input.value = formatted;

      let targetDigits = digitsBeforeCursor;
      if (isInitialDigit) {
        targetDigits = 2;
      } else if (allDigits.length > 0 && (allDigits.startsWith('7') || allDigits.startsWith('8')) && digitsBeforeCursor === 1) {
        targetDigits = 1;
      }

      const newCursor = getCursorPositionAfterDigits(formatted, targetDigits);
      input.setSelectionRange(newCursor, newCursor);

      if (view === 'contact') {
        const phoneVal = validatePhone(formatted);
        if (phoneVal.valid) {
          updateFieldStatus(input, true);
          if (contactError && !contactError.hidden) {
            contactError.hidden = true;
            contactError.textContent = '';
          }
        }
        render();
      }
    });

    phone.addEventListener('keydown', (event) => {
      if (event.key === 'Backspace') {
        const input = event.target;
        const start = input.selectionStart;
        const end = input.selectionEnd;

        if (start === end && start > 0) {
          const prevChar = input.value[start - 1];
          if (/\D/.test(prevChar)) {
            event.preventDefault();
            let pos = start - 1;
            while (pos >= 0 && /\D/.test(input.value[pos])) {
              pos--;
            }
            if (pos >= 0 && /\d/.test(input.value[pos])) {
              const digits = input.value.replace(/\D/g, '');
              if (digits.length <= 1) {
                input.value = '';
                updateFieldStatus(input, true);
                input.dispatchEvent(new Event('input', { bubbles: true }));
                return;
              }
              const val = input.value;
              const rawBefore = val.slice(0, pos).replace(/\D/g, '');
              const rawAfter = val.slice(pos + 1).replace(/\D/g, '');
              const newRaw = rawBefore + rawAfter;
              const formatted = formatRussianPhone(newRaw);
              input.value = formatted;
              const newCursor = getCursorPositionAfterDigits(formatted, rawBefore.length);
              input.setSelectionRange(newCursor, newCursor);
              input.dispatchEvent(new Event('input', { bubbles: true }));
            }
          }
        }
      }
    });

    phone.addEventListener('paste', (event) => {
      event.preventDefault();
      const pasted = (event.clipboardData || window.clipboardData)?.getData('text') || '';
      const pastedDigits = pasted.replace(/\D/g, '');
      if (!pastedDigits) return;

      const formatted = formatRussianPhone(pastedDigits);
      phone.value = formatted;
      phone.setSelectionRange(formatted.length, formatted.length);
      phone.dispatchEvent(new Event('input', { bubbles: true }));
    });

    phone.addEventListener('blur', () => {
      const digits = phone.value.replace(/\D/g, '');
      if (digits.length <= 1) {
        phone.value = '';
        phone.classList.remove('is-invalid');
        phone.removeAttribute('aria-invalid');
      } else {
        const phoneVal = validatePhone(phone.value);
        updateFieldStatus(phone, phoneVal.valid);
        if (!phoneVal.valid && contactError) {
          contactError.textContent = phoneVal.error;
          contactError.hidden = false;
        }
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const error = getContactError(true);
      if (error) {
        if (contactError) {
          contactError.textContent = error;
          contactError.hidden = false;
        }
        phone.focus();
        return;
      }
      if (contactError) {
        contactError.hidden = true;
        contactError.textContent = '';
      }
      showSuccess();
    });

    render();
    return { resetQuiz, render };
  };

  const quizzes = new Map(Array.from(document.querySelectorAll('[data-quiz-root]')).map((root) => [root, setupQuiz(root)]));
  const modalRoot = modal?.querySelector('[data-quiz-root]');
  const modalQuiz = modalRoot ? quizzes.get(modalRoot) : null;
  const openModal = (source) => {
    if (!modal || !modalQuiz) return;
    modalQuiz.resetQuiz();
    modalRoot.querySelector('input[name="cta_source"]').value = source || 'direct';
    if (!modal.open) modal.showModal();
    document.body.classList.add('quiz-modal-open');
    modalQuiz.render(true);
  };
  document.querySelectorAll('[data-quiz-open], [data-cta]:not([data-cta^="callback"]):not([data-callback-open]), a[href="#estimate"]').forEach((trigger) => trigger.addEventListener('click', (event) => { event.preventDefault(); openModal(trigger.dataset.cta || trigger.dataset.quizOpen || 'direct'); }));
  modal?.querySelector('[data-quiz-modal-close]').addEventListener('click', () => { modalQuiz?.resetQuiz(); modal.close(); });
  modal?.addEventListener('click', (event) => { if (event.target === modal) { modalQuiz?.resetQuiz(); modal.close(); } });
  modal?.addEventListener('close', () => { document.body.classList.remove('quiz-modal-open'); modalQuiz?.resetQuiz(); });
</script>

<style>
  .estimate { background: var(--paper); }
  .estimate__form-wrap { width: min(100%, 1040px); margin-inline: auto; }
  .quiz-header { max-width: 780px; margin: 0 auto 32px; text-align: center; }
  .quiz-header h2, .quiz-header .section-lead { margin-inline: auto; }
  .quiz-header__badge { display: inline-flex; align-items: center; gap: 7px; margin: 0 0 15px; padding: 6px 10px; border: 1px solid #c8d7ef; border-radius: 999px; color: var(--blue-deep); background: #eaf3ff; font-size: 12px; font-weight: 800; }
  .quiz-header__badge span { font-size: 17px; line-height: 0; }
  .estimate :global(.lead-quiz) { max-width: 820px; margin: 0 auto; border: 1px solid #d8d5cf; border-radius: 12px; box-shadow: 0 18px 44px rgb(22 23 25 / 6%); }
  .quiz-modal { width: min(860px, calc(100% - 24px)); max-height: min(840px, calc(100dvh - 32px)); margin: auto; padding: 0; border: 0; border-radius: 18px; background: transparent; overflow: visible; }
  .quiz-modal::backdrop { background: rgb(15 17 21 / 75%); backdrop-filter: blur(5px); }
  .quiz-modal__dialog { position: relative; max-height: inherit; overflow-y: auto; border-radius: inherit; background: var(--white); box-shadow: 0 24px 60px rgb(0 0 0 / 28%); }
  .quiz-modal__close { position: absolute; z-index: 10; top: 14px; right: 14px; display: grid; place-items: center; width: 36px; height: 36px; border: 0; border-radius: 50%; color: #66655f; background: #eceae5; cursor: pointer; font-size: 26px; line-height: 1; transition: color .15s, background-color .15s; }
  .quiz-modal__close:hover { color: var(--white); background: var(--ink); }
  .quiz-modal :global(.lead-quiz) { border: 0; border-radius: inherit; box-shadow: none; }
  .quiz-modal :global(.lead-quiz__progress) { padding-right: 48px; }
  @media (max-width: 640px) {
    .quiz-modal { width: calc(100% - 20px); max-height: calc(100dvh - 32px); border-radius: 18px; }
    .quiz-modal__dialog { min-height: unset; border-radius: 18px; }
    .quiz-modal :global(.lead-quiz) { padding: 22px 16px 24px; }
    .quiz-modal :global(.lead-quiz__progress) { padding-right: 36px; }
  }
</style>
