---
import { caseStudies as allCases } from "../data/cases";
import ButtonLink from "../components/ButtonLink.astro";
interface Props { vehicleSlug?: string; }
const { vehicleSlug } = Astro.props;
const illustrative = Boolean(vehicleSlug);
const caseStudies = vehicleSlug ? allCases.filter(item => item.vehicle === vehicleSlug) : allCases.filter(item => item.featured);
const single = caseStudies.length === 1;
---
<section class:list={["portfolio section section--dark", { "portfolio--single": single, "portfolio--illustrative": illustrative }]} id="portfolio" aria-labelledby="portfolio-title">
  <div class="container portfolio__intro">
    <div>
      <p class="eyebrow">ДО И ПОСЛЕ · {caseStudies.length} КЕЙСОВ</p>
      <h2 id="portfolio-title">Один ракурс — заметная разница</h2>
      <p class="section-lead">{illustrative ? "Иллюстративные пары для обсуждения обивки, фактуры и строчки. Потяните разделитель и покажите понравившиеся детали." : "Сначала показываем результат, затем — тот же кадр с естественными следами износа. Потяните разделитель, чтобы сравнить состояние обивки."}</p>
    </div>
    <div class="portfolio__actions"><ButtonLink href="#quiz" variant="outline" dataCta="portfolio">Подобрать похожее решение <span aria-hidden="true">↘</span></ButtonLink></div>
  </div>
  <div class="portfolio__carousel">
    <div class="swiper case-swiper" data-case-swiper={single ? undefined : true} aria-roledescription={single ? undefined : "carousel"} aria-label="Кейсы до и после">
      <div class="swiper-wrapper">
        {caseStudies.map(item => (
          <article class="swiper-slide case-card" data-case-card style="--compare-position: 52%;">
            <div class="case-card__media">
              <>
                <img class="case-card__image case-card__image--before-base" src={item.before.src} alt={'До обновления: ' + item.title} loading="lazy" width={item.before.width} height={item.before.height} />
                <img class="case-card__image case-card__image--after" src={item.after.src} alt={'После обновления: ' + item.title} loading="lazy" width={item.after.width} height={item.after.height} />
                <div class="case-card__before"><img class="case-card__image" src={item.before.src} alt="" loading="lazy" width={item.before.width} height={item.before.height} /></div>
                <div class="case-card__divider" aria-hidden="true"><span>↔</span></div>
                <span class="case-card__label case-card__label--before">До</span><span class="case-card__label case-card__label--after">После</span>
                <input class="case-card__range" type="range" min="12" max="88" value="52" aria-label={'Сравнение состояния сиденья: до и после. ' + item.title} />
              </>
            </div>
            <div class="case-card__body">
              <p>{item.tags}</p>
              <div><div><h3>{item.title}</h3><p>{item.text}</p></div></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
  {!single && <div class="container portfolio__controls" role="group" aria-label="Листать кейсы">
    <button type="button" data-case-prev aria-label="Предыдущий пример"><svg aria-hidden="true"><use href="#arrow" /></svg></button>
    <button type="button" data-case-next aria-label="Следующий пример"><svg aria-hidden="true"><use href="#arrow" /></svg></button>
  </div>}
  <div class="portfolio__bottom-action container"><ButtonLink href="#quiz" variant="outline" dataCta="portfolio">Подобрать похожее решение <span aria-hidden="true">↘</span></ButtonLink></div>
</section>
<script>
  import Swiper from "swiper";
  import { A11y, Navigation } from "swiper/modules";
  import "swiper/css";

  const hopRoot = document.getElementById("hop-gutenberg") || document;
  hopRoot.querySelectorAll("[data-case-card]").forEach((card) => {
    const range = card.querySelector<HTMLInputElement>(".case-card__range");
    const updatePosition = () =>
      card.style.setProperty("--compare-position", `${range?.value ?? 52}%`);
    range?.addEventListener("input", updatePosition);
  });
  const caseSwiper = hopRoot.querySelector("[data-case-swiper]");
  if (caseSwiper) {
    new Swiper(caseSwiper, {
      modules: [A11y, Navigation],
      navigation: {
        prevEl: hopRoot.querySelector("[data-case-prev]"),
        nextEl: hopRoot.querySelector("[data-case-next]"),
      },
      slidesPerView: 1.1,
      spaceBetween: 14,
      grabCursor: true,
      a11y: {
        prevSlideMessage: "Предыдущий кейс",
        nextSlideMessage: "Следующий кейс",
      },
      breakpoints: {
        768: {
          slidesPerView: "auto",
          spaceBetween: 28,
        },
      },
    });
  }
</script>

<style>
  .portfolio__controls { display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px; }
  .portfolio__controls button { display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid var(--cyan); border-radius: 12px; color: var(--cyan); background: transparent; cursor: pointer; }
  .portfolio__controls button:hover { background: #9ee4fc22; }
  .portfolio__controls button:disabled { opacity: .35; cursor: default; }
  .portfolio__controls svg { width: 22px; height: 22px; }
  [data-case-prev] svg { transform: rotate(180deg); }
  .portfolio--single .portfolio__carousel { width: min(var(--container-width), calc(100% - var(--gutter) * 2)); margin-inline: auto; }
  .portfolio--single .swiper-wrapper { display: block; }
  .portfolio--single .case-swiper .swiper-slide { width: 100%; }
  .portfolio--single .case-card { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }
  .portfolio--single .case-card__body { align-self: center; }
  @media(max-width: 767px) { .portfolio--single .case-card { grid-template-columns: minmax(0, 1fr); } }

  .portfolio {
    overflow: hidden;
    padding-block: clamp(68px, 9vw, 130px);
    background: var(--night);
  }
  .portfolio__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 36px;
    align-items: end;
    margin-bottom: 48px;
  }
  .portfolio h2 {
    max-width: 720px;
    font-family: var(--body-font);
    font-size: clamp(38px, 4.1vw, 59px);
    font-weight: 700;
    letter-spacing: -0.055em;
  }
  .portfolio__intro .section-lead {
    max-width: 680px;
    margin-bottom: 0;
    color: #bdb8b7;
  }
  .portfolio__actions {
    display: flex;
    align-items: flex-end;
  }
  .portfolio__bottom-action {
    display: none;
  }
  .portfolio__carousel {
    width: calc(100% - max(var(--gutter), (100% - var(--container-width)) / 2));
    margin-left: max(var(--gutter), (100% - var(--container-width)) / 2);
  }
  .case-swiper {
    overflow: visible;
  }
  .case-swiper .swiper-slide {
    width: min(760px, calc(100vw - max(72px, var(--gutter) * 2)));
    height: auto;
  }
  .case-card {
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: 28px;
    background: #103761;
  }
  .case-card__media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #0d0d0e;
  }
  .case-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .case-card__image--before-base {
    display: none;
  }
  .case-card__before {
    position: absolute;
    z-index: 2;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--compare-position)) 0 0);
  }
  .case-card__before img {
    filter: grayscale(0.1) contrast(0.9);
  }
  .case-card__divider {
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    left: var(--compare-position);
    width: 2px;
    transform: translateX(-50%);
    background: #fff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 18%);
    pointer-events: none;
  }
  .case-card__divider span {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border: 3px solid #fff;
    border-radius: 50%;
    color: #fff;
    background: var(--yellow);
    color: var(--ink);
    box-shadow: 0 5px 16px rgb(0 0 0 / 28%);
    font-size: 19px;
    font-weight: 800;
    line-height: 1;
    transform: translate(-50%, -50%);
  }
  .case-card__label {
    position: absolute;
    z-index: 3;
    top: 20px;
    padding: 7px 12px;
    border-radius: 999px;
    color: var(--white);
    background: rgb(29 25 26 / 76%);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .case-card__label--before {
    left: 20px;
  }
  .case-card__label--after {
    right: 20px;
    color: #241f20;
    background: #f7f2ed;
  }
  .case-card__range {
    position: absolute;
    z-index: 4;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: ew-resize;
    opacity: 0.001;
  }
  .case-card__media:has(.case-card__range:focus-visible) {
    outline: 3px solid var(--orange);
    outline-offset: -3px;
  }
  .case-card__body {
    padding: 23px 25px 25px;
  }
  .case-card__body > p:first-child {
    margin: 0 0 16px;
    color: var(--cyan);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.09em;
  }
  .case-card__body > div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }
  .case-card__number {
    color: var(--orange);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    writing-mode: vertical-rl;
  }
  .case-card__body h3 {
    margin: 0 0 9px;
    color: #f8f4f0;
    font-size: clamp(24px, 2.2vw, 32px);
    font-weight: 500;
  }
  .case-card__body > div p {
    margin: 0;
    color: #c7c0bf;
    font-size: 14px;
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .portfolio__intro {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    .portfolio__actions {
      justify-content: flex-start;
    }
    .case-card__body h3 {
      font-size: 26px;
    }
  }

  @media (max-width: 767px) {
    .portfolio__intro {
      margin-bottom: 24px;
    }
    .portfolio__intro .section-lead {
      font-size: 15px;
    }
    .portfolio__actions {
      display: none !important;
    }
    .portfolio__bottom-action {
      display: block;
      margin-top: 24px;
    }
    .portfolio__bottom-action :global(.button) {
      width: 100%;
    }
    .portfolio__carousel {
      width: calc(100% - var(--gutter));
      margin-left: var(--gutter);
    }
    .case-swiper .swiper-slide {
      width: auto;
    }
    .case-card {
      border-radius: 20px;
    }
    .case-card__label {
      top: 12px;
      padding: 6px 9px;
      font-size: 8px;
    }
    .case-card__label--before {
      left: 12px;
    }
    .case-card__label--after {
      right: 12px;
    }
    .case-card__divider span {
      width: 38px;
      height: 38px;
      border-width: 2px;
      font-size: 16px;
    }
    .case-card__body {
      padding: 18px 16px 20px;
    }
    .case-card__body > div {
      gap: 14px;
    }
    .case-card__body h3 {
      font-size: 20px;
    }
  }

</style>
