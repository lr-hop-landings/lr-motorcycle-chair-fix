---
import { vehiclePages } from "../data/vehicles";
interface Props {
  activeVehicleSlug?: string;
}
const { activeVehicleSlug } = Astro.props;
const isNavigation = Boolean(activeVehicleSlug);
---

<section
  class:list={["vehicles section", { "vehicles--nav": isNavigation }]}
  aria-labelledby="vehicles-title"
>
  <div class="container">
    <p class="eyebrow">
      {isNavigation ? "ВЫБЕРИТЕ ТИП ТЕХНИКИ" : "ДЛЯ ВАШЕЙ ТЕХНИКИ"}
    </p><div class="section-head">
      <h2 id="vehicles-title">
        {
          isNavigation
            ? "Перейти к другому разделу"
            : "Мотоциклы, квадроциклы и не только"
        }
      </h2><p>
        {
          isNavigation
            ? "На каждой странице — подходящие примеры, варианты работ и вопросы для оценки сиденья."
            : "Конструкция и условия эксплуатации отличаются — поэтому решение начинаем с коротких вопросов о конкретном сиденье."
        }
      </p>
    </div><div class="vehicles__grid">
      {
        vehiclePages.map(({ name, cardText, slug, theme, image }) => {
          const content = (
            <>
              <div class="vehicle__media">
                <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" />
              </div>
              <h3>{name}</h3>
              <p>{cardText}</p>
            </>
          );
          return activeVehicleSlug === slug ? (
            <div
              class="vehicle vehicle--active"
              style={`--vehicle-color: ${theme.color}`}
              aria-label={`${name} — текущий раздел`}
            >
              {content}
              <span class="vehicle__link">Текущий раздел</span>
            </div>
          ) : (
            <a
              class="vehicle"
              style={`--vehicle-color: ${theme.color}`}
              href={`/${slug}/`}
              data-cta="vehicle_page"
            >
              {content}
              <span class="vehicle__link">
                Перейти <span aria-hidden="true">→</span>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .vehicles {
    background: var(--white);
  }
  .section-head {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 42px;
  }
  .section-head h2 {
    margin: 0;
  }
  .section-head p {
    max-width: 420px;
    margin: 0 0 5px;
    color: var(--muted);
  }
  .vehicles__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .vehicles--nav {
    padding-block: clamp(52px, 6vw, 76px);
  }
  .vehicles--nav .section-head {
    margin-bottom: 28px;
  }
  .vehicles--nav .section-head h2 {
    font-size: clamp(34px, 3.4vw, 48px);
  }
  .vehicles--nav .vehicle {
    min-height: 142px;
    padding: 30px 24px 20px;
  }
  .vehicles--nav .vehicle::before {
    height: 8px;
  }
  .vehicles--nav .vehicle p {
    display: none;
  }
  .vehicles--nav .vehicle h3 {
    flex: 1;
    margin-bottom: 20px;
  }
  .vehicle {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 268px;
    padding: 38px 28px 24px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--vehicle-color) 24%, var(--line));
    border-radius: 16px;
    background: color-mix(in srgb, var(--vehicle-color) 9%, white);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.18s ease,
      transform 0.18s ease;
  }
  .vehicle__media {
    position: relative;
    aspect-ratio: 4 / 3;
    margin: -38px -28px 24px;
    overflow: hidden;
    background: color-mix(in srgb, var(--vehicle-color) 18%, var(--night));
  }
  .vehicle__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(0 0 0 / 0.22));
    pointer-events: none;
  }
  .vehicle__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  a.vehicle:hover .vehicle__media img {
    transform: scale(1.035);
  }
  .vehicle::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 12px;
    background: var(--vehicle-color);
  }
  .vehicle:hover {
    border-color: color-mix(in srgb, var(--vehicle-color) 48%, var(--line));
    transform: translateY(-3px);
  }
  a.vehicle:focus-visible {
    outline: 3px solid var(--vehicle-color);
    outline-offset: 4px;
  }
  .vehicle--active {
    border-color: color-mix(in srgb, var(--vehicle-color) 55%, var(--line));
    background: color-mix(in srgb, var(--vehicle-color) 14%, white);
    box-shadow: inset 0 0 0 1px
      color-mix(in srgb, var(--vehicle-color) 22%, transparent);
  }
  .vehicle h3 {
    margin: 0 0 14px;
  }
  .vehicle p {
    flex: 1;
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 17px;
  }
  .vehicle__link {
    align-self: flex-start;
    color: var(--vehicle-color);
    font-size: 14px;
    font-weight: 800;
  }
  a.vehicle:hover .vehicle__link {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  @media (max-width: 1050px) {
    .vehicles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .section-head {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  @media (max-width: 640px) {
    .vehicles__grid {
      grid-template-columns: 1fr;
    }
    .vehicle {
      min-height: unset;
      padding: 36px 25px 25px;
    }
    .vehicle__media {
      margin: -36px -25px 22px;
    }
    .vehicle p {
      min-height: 0;
    }
    .vehicles--nav {
      padding-block: 46px;
    }
    .vehicles--nav .section-head {
      margin-bottom: 22px;
    }
    .vehicles--nav .section-head p {
      margin-top: 14px;
      font-size: 15px;
    }
    .vehicles--nav .vehicles__grid {
      gap: 10px;
    }
    .vehicles--nav .vehicle {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 14px;
      align-items: center;
      min-height: 78px;
      padding: 24px 18px 18px 22px;
    }
    .vehicles--nav .vehicle h3 {
      margin: 0;
      font-size: 21px;
    }
    .vehicles--nav .vehicle p {
      display: none;
    }
    .vehicles--nav .vehicle__link {
      font-size: 12px;
      text-align: right;
    }
  }
</style>
