---
import workshopStaging from "../assets/motoSeat/workshopStaging.webp";
import ButtonLink from "../components/ButtonLink.astro";
import SocialLinks from "../components/SocialLinks.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__copy container">
    <p class="eyebrow">МАСТЕРСКАЯ · САНКТ-ПЕТЕРБУРГ И ЛО</p>
    <h1 id="hero-title">
      <span>Перетяжка сидений</span><span>мотоциклов, квадроциклов</span><span
        >и другой мототехники</span
      >
    </h1>
    <p class="hero__lead">
      Восстановим поврежденную обивку или изменим внешний вид сиденья. Подберем
      материал под вашу технику и предварительно сориентируем по стоимости.
    </p>
    <ul class="hero__benefits" aria-label="Преимущества мастерской">
      <li>Итоговую стоимость согласуем до начала работы</li>
      <li>Гарантия на перетяжку — 1 год</li>
      <li>Доставка техники в мастерскую и обратно</li>
    </ul>
    <div class="hero__actions">
      <ButtonLink href="#estimate" dataCta="hero"
        ><svg aria-hidden="true" viewBox="0 0 24 24"
          ><path
            d="M4 7.5h3l1.35-2h7.3l1.35 2h3a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2Z"
          ></path><circle cx="12" cy="13.5" r="3.25"></circle></svg
        >Рассчитать перетяжку</ButtonLink
      >
      <ButtonLink href="#portfolio" variant="ghost"
        >Посмотреть работы</ButtonLink
      >
    </div>
    <div class="hero__social">
      <div class="hero__social-label">Или напишите нам в мессенджере</div>
      <SocialLinks isCompact />
      <div class="hero__social-label">Также можете позвонить по номеру</div>
      <a class="hero__phone" href="tel:+78123444444">+7 (812) 344-44-44</a>
    </div>
  </div>
  <!-- <div class="hero__drawing" aria-hidden="true">
    <svg class="hero__measure" viewBox="0 0 580 205"
      ><path
        d="M95 109c16-32 48-47 82-49 39-3 70 11 102 16 46 8 79 4 126 21 29 10 57 31 87 56l-59 7c-32-24-63-35-99-39-47-5-87 2-132 1-43-1-79-6-107-13Z"
      ></path><path
        class="hero__seat-dots"
        d="M111 106c24-25 49-33 77-35 34-2 61 10 96 16 46 8 81 6 116 20"
      ></path><path
        class="hero__dimension"
        d="M60 160h421M60 139v42M481 139v42M77 160h387M77 155l-11 5 11 5M464 155l11 5-11 5M61 55v82M82 55H40M82 137H40M61 72v48M56 72l5-11 5 11M56 120l5 11 5-11"
      ></path><text x="241" y="184">680</text><text x="14" y="103">320</text
      ></svg
    >
  </div> -->
  <div class="hero__visual" aria-label="Визуал процесса перетяжки">
    <img
      src={workshopStaging.src}
      alt="Мастер прошивает обивку мотоциклетного сиденья на промышленной машине"
      width="1536"
      height="1024"
      fetchpriority="high"
    />
    <!-- <span class="hero__stamp"
      >ВИЗУАЛ КОНЦЕПЦИИ · ЗАМЕНИТЬ НА ФОТО МАСТЕРСКОЙ</span
    > -->
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    overflow: hidden;
    color: var(--white);
    background: #18191c;
  }
  .hero__copy {
    position: relative;
    z-index: 2;
    align-self: start;
    width: 100%;
    margin: 0;
    padding: clamp(72px, 11vh, 128px) clamp(28px, 3vw, 54px)
      clamp(64px, 6vw, 92px);
  }
  .hero h1 {
    /* max-width: 660px; */
    margin-bottom: 21px;
    font-family: "Oswald Local", "Arial Narrow", sans-serif;
    font-size: clamp(52px, 4.45vw, 72px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.99;
    text-shadow: 0 3px 24px rgb(0 0 0 / 22%);
    text-transform: uppercase;
  }
  .hero h1 span {
    display: block;
    white-space: nowrap;
  }
  .hero__lead {
    max-width: 620px;
    margin-bottom: 31px;
    color: #e2e2e3;
    font-size: 16px;
    line-height: 1.45;
  }
  .hero__benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
    max-width: 560px;
    margin: 0 0 27px;
    padding: 0;
    border-top: 1px solid rgb(255 255 255 / 16%);
    list-style: none;
    color: #f1f0ed;
    font-size: 13px;
    font-weight: 650;
    line-height: 1.35;
  }
  .hero__benefits li {
    display: flex;
    align-items: center;
    min-height: 31px;
    height: 100%;
    gap: 10px;
    padding: 6px;
    border-bottom: 1px solid rgb(255 255 255 / 12%);
  }
  .hero__benefits li::before {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 17px;
    height: 17px;
    border: 1px solid rgb(235 128 35 / 75%);
    border-radius: 50%;
    color: var(--orange);
    content: "✓";
    font-size: 11px;
    font-weight: 800;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  :global(.hero__actions .button) {
    min-height: 52px;
    padding-inline: 22px;
  }
  .hero__social {
    display: grid;
    width: min(100%, 570px);
    gap: 11px;
    margin-top: 23px;
  }
  .hero__social-label {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #d1a78f;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero__social-label::after {
    height: 1px;
    flex: 1;
    background: rgba(255, 255, 255, 0.18);
    content: "";
  }
  .hero__phone {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: 7px;
    color: var(--white);
    border: 1px solid var(--white);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    transition:
      background 0.16s ease,
      color 0.16s ease,
      transform 0.16s ease;
  }
  .hero__phone:hover {
    background: var(--white);
    color: var(--blue);
    transform: translateY(-1px);
  }
  .hero__drawing {
    position: absolute;
    z-index: 2;
    bottom: clamp(20px, 4vh, 42px);
    left: clamp(19px, 2.4vw, 40px);
    width: min(36vw, 448px);
  }
  .hero__visual {
    position: absolute;
    z-index: 0;
    inset: 0 0 0 40%;
    overflow: hidden;
  }
  .hero__visual::before {
    position: absolute;
    z-index: 1;
    inset: 0 auto 0 0;
    width: 62%;
    background: linear-gradient(
      90deg,
      #18191c 0%,
      rgb(24 25 28 / 93%) 27%,
      rgb(24 25 28 / 38%) 66%,
      transparent 100%
    );
    content: "";
  }
  .hero__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 74% center;
    filter: brightness(0.78) saturate(0.78);
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgb(0 0 0 / 16%) 10%,
      #000 43%,
      #000 100%
    );
  }
  .hero__stamp {
    position: absolute;
    z-index: 2;
    right: 28px;
    bottom: 24px;
    padding: 6px 8px;
    border: 1px solid #78736b;
    color: #d4cec5;
    background: rgb(20 20 22 / 63%);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .hero__measure {
    display: block;
    width: 100%;
    fill: none;
    stroke: #c0c0c2;
    stroke-width: 1;
    opacity: 0.74;
  }
  .hero__measure .hero__seat-dots {
    stroke-dasharray: 2 4;
  }
  .hero__measure .hero__dimension {
    stroke: var(--orange);
  }
  .hero__measure text {
    fill: var(--orange);
    stroke: none;
    font-family: var(--body-font);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  @media (max-width: 900px) {
    .hero {
      min-height: unset;
      grid-template-rows: auto 390px;
    }
    .hero__copy {
      width: min(var(--container-width), calc(100% - var(--gutter) * 2));
      padding: 70px 0 52px;
    }
    .hero__visual {
      position: relative;
      inset: auto;
      grid-row: 2;
    }
    .hero__visual::before {
      inset: 0;
      width: 100%;
      background: linear-gradient(0deg, var(--ink), transparent 45%);
    }
    .hero__visual img {
      object-position: 62% center;
      mask-image: none;
    }
    .hero__drawing {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .hero h1 {
      font-size: 44px;
      line-height: 1.02;
    }
    .hero h1 span {
      white-space: normal;
    }
    .hero__actions {
      display: grid;
      grid-template-columns: 1fr;
    }
    :global(.hero__actions .button) {
      width: 100%;
    }
    .hero__visual {
      height: 290px;
    }
    .hero__stamp {
      right: 12px;
      bottom: 12px;
      font-size: 8px;
    }
  }
</style>
