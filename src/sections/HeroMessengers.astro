---
import MessengerCards from "../components/MessengerCards.astro";
---

<section class="hero-messengers" aria-label="Связаться в мессенджере">
  <div class="wrap">
    <h2 class="hero-contact-title hero-messengers__label">
      <span>Или написать в мессенджере</span>
    </h2>
    <MessengerCards />
  </div>
</section>
<style>
  .hero-messengers {
    padding: 0 0 36px;
    color: white;
    background: var(--night);
  }
  .hero-messengers__label {
    margin-bottom: 20px;
  }
  @media (max-width: 760px) {
    .hero-messengers {
      padding-bottom: 26px;
    }
  }
</style>
