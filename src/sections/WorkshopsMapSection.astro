---
import { workshops } from "../data/workshops";
---

<section class="workshops-map section" aria-labelledby="workshops-map-title">
  <div class="wrap">
    <div class="section-top">
      <div>
        <div class="eyebrow">25 точек в Санкт-Петербурге и области</div>
        <h2 id="workshops-map-title">Выберите удобную мастерскую</h2>
      </div>
      <p>Все адреса Ленремонта на одной карте. Нажмите на точку, чтобы увидеть адрес, метро и телефон.</p>
    </div>

    <div class="workshops-map__layout">
      <div class="workshops-map__canvas" data-workshop-map aria-label="Карта мастерских Ленремонта">
        <div id="dmap" data-workshops={JSON.stringify(workshops)}>
          <dmap></dmap>
        </div>
      </div>
      <div class="workshops-map__list" aria-label="Список мастерских">
        {workshops.map((workshop, index) => (
          <a class="workshop-card" id={`workshop-${index + 1}`} href={`#workshop-${index + 1}`} data-workshop-index={index}>
            <span class="workshop-card__number">{String(index + 1).padStart(2, "0")}</span>
            <span>
              {workshop.metro && <small>м. {workshop.metro}</small>}
              <strong>{workshop.title}</strong>
              <span class="workshop-card__phone">{workshop.phone}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
    <p class="workshops-map__note">Не хотите ехать? Позвоните — мы сами заберём технику в мастерскую за 390 ₽.</p>
  </div>
</section>

<script is:inline>
  (() => {
    const dmapRoot = document.querySelector("[data-workshop-map] #dmap");
    if (!dmapRoot || dmapRoot.dataset.loaded) return;
    dmapRoot.dataset.loaded = "true";

    const workshops = JSON.parse(dmapRoot.dataset.workshops || "[]");
    const mapConfig = {
      settings: {
        center: { lat: 59.95, lng: 30.3 },
        zoom: 10,
        markerZoom: 15,
        icon: "/assets/reference/2gis-marker.svg",
        iconSize: [32, 40],
        commonTextBlock: { show: true, text: "Не хотите ехать? Звоните и мы сами заберем Вашу технику в мастерскую за 390 ₽" },
        deliveryMoreLink: { show: false, label: "", link: "#" },
      },
      markers: workshops.map((workshop) => ({
        position: { lat: workshop.lat, lng: workshop.lng },
        title: workshop.title,
        metroStation: workshop.metro || "",
        phoneNumber: workshop.phone,
        instructionUri: workshop.instructionUri,
        notice: false,
      })),
    };

    window.jQuery = window.jQuery || {};
    window.jQuery.get = () => ({
      done(callback) {
        callback(mapConfig);
        return this;
      },
    });

    const loadScript = (src, next) => {
      const script = document.createElement("script");
      script.src = src;
      script.async = false;
      script.onload = next;
      document.head.appendChild(script);
    };

    loadScript("/assets/dynamic-map/vue_2.6.12.js", () => {
      loadScript("/assets/dynamic-map/dmap.js", () => {
        const connectCards = () => {
          const mapVm = dmapRoot.__vue__?.$children?.[0];
          if (!mapVm?.map || !mapVm.markers?.length) {
            window.setTimeout(connectCards, 50);
            return;
          }
          document.querySelectorAll("[data-workshop-index]").forEach((card) => {
            card.addEventListener("click", (event) => {
              event.preventDefault();
              const index = Number(card.dataset.workshopIndex);
              const marker = mapVm.markers[index];
              if (!marker) return;
              mapVm.map.flyTo(marker.position, mapVm.markerZoom || 15);
              marker.marker.openPopup();
            });
          });
        };
        connectCards();
      });
    });
  })();
</script>

<style>
  .workshops-map {
    background: var(--surface);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .workshops-map .section-top { align-items: center; }
  .workshops-map__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(300px, .6fr);
    min-height: 560px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--bg);
    box-shadow: var(--shadow);
  }
  .workshops-map__canvas { min-height: 560px; background: #dce9ef; }
  .workshops-map__canvas > #dmap { width: 100%; height: 100%; min-height: inherit; }
  .workshops-map__list { max-height: 560px; overflow: auto; padding: 12px; }
  .workshop-card {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 12px;
    padding: 15px 12px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    transition: background .18s, transform .18s;
  }
  .workshop-card:hover, .workshop-card:focus-visible { background: var(--soft); transform: translateX(2px); outline: 0; }
  .workshop-card__number { color: var(--blue); font-size: 13px; font-weight: 800; padding-top: 2px; }
  .workshop-card small, .workshop-card strong, .workshop-card__phone { display: block; }
  .workshop-card small { color: var(--muted); font-size: 12px; margin-bottom: 2px; }
  .workshop-card strong { font-size: 15px; line-height: 1.3; }
  .workshop-card__phone { color: var(--blue); font-size: 13px; margin-top: 5px; }
  .workshops-map__note { margin: 18px 0 0; color: var(--muted); font-size: 15px; }
  :global(#dmap .dmap-container) { height: 100% !important; min-height: 560px; background: transparent; }
  :global(#dmap .point-map) { height: 100% !important; }
  :global(#dmap .point-list), :global(#dmap .point-info), :global(#dmap .control-button) { display: none !important; }
  :global(.leaflet-popup-content) { display: grid; gap: 5px; min-width: 190px; margin: 14px 16px; font: 14px/1.4 'Manrope', sans-serif; }
  :global(.leaflet-popup-content a) { color: var(--blue); text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 900px) {
    .workshops-map__layout { grid-template-columns: 1fr; }
    .workshops-map__canvas { min-height: 430px; }
    :global(#dmap .dmap-container) { min-height: 430px; }
    .workshops-map__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); max-height: 370px; }
  }
  @media (max-width: 560px) {
    .workshops-map__layout { border-radius: 18px; }
    .workshops-map__canvas { min-height: 360px; }
    :global(#dmap .dmap-container) { min-height: 360px; }
    .workshops-map__list { grid-template-columns: 1fr; max-height: 330px; padding: 8px; }
    .workshop-card { padding: 13px 9px; }
  }
</style>
