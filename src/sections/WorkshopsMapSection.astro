---
import { workshops } from "../data/workshops";
---

<section class="workshops-map section" aria-labelledby="workshops-map-title">
  <div class="wrap">
    <div class="section-top">
      <div>
        <div class="eyebrow">25 точек в Санкт-Петербурге и области</div>
        <h2 id="workshops-map-title">Выберите удобную мастерскую</h2>
      </div>
      <p>Все адреса Ленремонта на одной карте. Нажмите на точку, чтобы увидеть адрес, метро и телефон.</p>
    </div>

    <div class="workshops-map__layout">
      <div class="workshops-map__canvas" data-workshop-map aria-label="Карта мастерских Ленремонта"></div>
      <div class="workshops-map__list" aria-label="Список мастерских">
        {workshops.map((workshop, index) => (
          <a class="workshop-card" id={`workshop-${index + 1}`} href={`#workshop-${index + 1}`} data-workshop-index={index}>
            <span class="workshop-card__number">{String(index + 1).padStart(2, "0")}</span>
            <span>
              {workshop.metro && <small>м. {workshop.metro}</small>}
              <strong>{workshop.title}</strong>
              <span class="workshop-card__phone">{workshop.phone}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
    <p class="workshops-map__note">Не хотите ехать? Позвоните — мы сами заберём технику в мастерскую за 390 ₽.</p>
  </div>
</section>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script define:vars={{ workshops }}>
  const mapRoot = document.querySelector("[data-workshop-map]");
  const workshopList = document.querySelectorAll("[data-workshop-index]");

  const initWorkshopsMap = () => {
    if (!mapRoot || !window.L || mapRoot.dataset.ready) return;
    mapRoot.dataset.ready = "true";
    const L = window.L;
    const map = L.map(mapRoot, { scrollWheelZoom: false, zoomControl: true }).setView([59.95, 30.3], 10);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap contributors',
    }).addTo(map);

    const markerIcon = L.divIcon({
      className: "workshop-marker",
      html: '<span class="workshop-marker__dot"></span>',
      iconSize: [26, 26],
      iconAnchor: [13, 13],
      popupAnchor: [0, -15],
    });
    const escapeHtml = value => String(value).replace(/[&<>"']/g, char => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" }[char]));
    const markers = workshops.map((workshop, index) => {
      const metro = workshop.metro ? `<div class="workshop-popup__metro">м. ${escapeHtml(workshop.metro)}</div>` : "";
      const popup = `<strong>${escapeHtml(workshop.title)}</strong>${metro}<a href="tel:${escapeHtml(workshop.phone)}">${escapeHtml(workshop.phone)}</a><a href="${escapeHtml(workshop.instructionUri)}">Как добраться →</a>`;
      const marker = L.marker([workshop.lat, workshop.lng], { icon: markerIcon, alt: workshop.title }).addTo(map).bindPopup(popup);
      marker.on("click", () => document.querySelector(`[data-workshop-index="${index}"]`)?.scrollIntoView({ block: "nearest", behavior: "smooth" }));
      return marker;
    });

    workshopList.forEach(card => card.addEventListener("click", event => {
      event.preventDefault();
      const index = Number(card.dataset.workshopIndex);
      const workshop = workshops[index];
      map.setView([workshop.lat, workshop.lng], 15, { animate: true });
      markers[index].openPopup();
    }));
  };

  if (window.L) initWorkshopsMap();
  else window.addEventListener("load", initWorkshopsMap, { once: true });
</script>

<style>
  .workshops-map {
    background: var(--surface);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .workshops-map .section-top { align-items: center; }
  .workshops-map__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(300px, .6fr);
    min-height: 560px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--bg);
    box-shadow: var(--shadow);
  }
  .workshops-map__canvas { min-height: 560px; background: #dce9ef; }
  .workshops-map__list { max-height: 560px; overflow: auto; padding: 12px; }
  .workshop-card {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 12px;
    padding: 15px 12px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    transition: background .18s, transform .18s;
  }
  .workshop-card:hover, .workshop-card:focus-visible { background: var(--soft); transform: translateX(2px); outline: 0; }
  .workshop-card__number { color: var(--blue); font-size: 13px; font-weight: 800; padding-top: 2px; }
  .workshop-card small, .workshop-card strong, .workshop-card__phone { display: block; }
  .workshop-card small { color: var(--muted); font-size: 12px; margin-bottom: 2px; }
  .workshop-card strong { font-size: 15px; line-height: 1.3; }
  .workshop-card__phone { color: var(--blue); font-size: 13px; margin-top: 5px; }
  .workshops-map__note { margin: 18px 0 0; color: var(--muted); font-size: 15px; }
  .workshop-marker { display: grid; place-items: center; border: 0; background: transparent; }
  .workshop-marker__dot { display: block; width: 22px; height: 22px; border: 4px solid white; border-radius: 50%; background: var(--blue); box-shadow: 0 3px 12px #092c5666; }
  :global(.workshop-popup__metro) { color: var(--muted); font-size: 12px; margin: 5px 0; }
  :global(.leaflet-popup-content) { display: grid; gap: 5px; min-width: 190px; margin: 14px 16px; font: 14px/1.4 'Manrope', sans-serif; }
  :global(.leaflet-popup-content a) { color: var(--blue); text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 900px) {
    .workshops-map__layout { grid-template-columns: 1fr; }
    .workshops-map__canvas { min-height: 430px; }
    .workshops-map__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); max-height: 370px; }
  }
  @media (max-width: 560px) {
    .workshops-map__layout { border-radius: 18px; }
    .workshops-map__canvas { min-height: 360px; }
    .workshops-map__list { grid-template-columns: 1fr; max-height: 330px; padding: 8px; }
    .workshop-card { padding: 13px 9px; }
  }
</style>
